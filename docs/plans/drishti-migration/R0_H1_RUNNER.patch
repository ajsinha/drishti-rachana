+ * Unauthorised copying, use, modification, distribution or disclosure of this
+ * file, via any medium, is strictly prohibited except with the express prior
+ * written permission of the copyright holder.
+ *
+ * See the LICENSE file in the root of this repository for the full terms.
+ */
+package com.ash.drishti.rachana.conformance;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Pattern;
+
+/**
+ * The JVM reference runner of the conformance suite (Rachana {@code conformance/RUNNER.md}): reads and checks every case file of a
+ * {@link CaseSource}, merges each file's {@code since}, {@code profile}, {@code verified} and {@code given} into its cases, runs the
+ * kinds it is given (a kind it is not given, a profile it does not load and a later {@code since} are {@code unsupported}), compares
+ * with {@link Expect}, writes {@code <runtime>.jsonl} (one canonical line per case, RUNNER 4.1) and the summary, and in record mode
+ * fills {@code expect} of unverified cases from the reference (RUNNER 6).
+ */
+public final class ConformanceRun {
+
+    static final Set<String> KINDS = Set.of("expr", "expr-error", "check", "grammar", "format", "sutra", "problem", "patch", "plan", "edit", "protocol");
+    static final Pattern ID = Pattern.compile("[a-z0-9][a-z0-9-]{0,79}");
+
+    /**
+     * @param runtime the runtime name written in the summary ({@code jvm})
+     * @param language the language minor the runtime implements; cases with a later {@code since} are unsupported
+     * @param profiles the profiles loaded ({@code core} always)
+     * @param only case-id globs to run ({@code el/**}); empty is all
+     */
+    public record Options(String runtime, String language, Set<String> profiles, List<String> only) {
+        public static Options of(String runtime) {
+            return new Options(runtime, System.getProperty("rachana.conformance.language", "1.0"), Set.of("core", "drishti"),
+                    List.of(System.getProperty("rachana.conformance.only", "").split(",")).stream().filter(s -> !s.isBlank()).toList());
+        }
+    }
+
+    /** One case and what became of it. */
+    public record Result(String id, String kind, String status, Map<String, Object> actual, boolean verified, String detail, Map<String, Object> c,
+            CaseSource.SuiteFile file) {
+        public String suite() {
+            return id.substring(0, id.indexOf('#'));
+        }
+    }
+
+    private ConformanceRun() {}
+
+    /** Runs every selected case; a file that does not parse or check is a usage failure (an exception, nothing is run). */
+    public static List<Result> run(CaseSource source, Map<String, KindRunner> kinds, Options o) {
+        List<Object[]> todo = new ArrayList<>();
+        for (CaseSource.SuiteFile f : source.files()) {
+            Map<String, Object> doc = check(f);
+            for (Object raw : (List<?>) doc.get("cases")) {
+                Map<String, Object> c = merged(doc, CoreKinds.map(raw));
+                String id = f.suite() + "#" + c.get("id");
+                if (o.only().isEmpty() || o.only().stream().anyMatch(g -> glob(g, id))) {
+                    todo.add(new Object[] {f, c, id});
+                }
+            }
+        }
+        List<Result> out = new ArrayList<>();
+        for (Object[] t : todo) {
+            CaseSource.SuiteFile f = (CaseSource.SuiteFile) t[0];
+            @SuppressWarnings("unchecked")
+            Map<String, Object> c = (Map<String, Object>) t[1];
+            String id = (String) t[2];
+            String kind = (String) c.get("kind");
+            boolean verified = Boolean.TRUE.equals(c.get("verified"));
+            KindRunner k = kinds.get(kind);
+            String why = unsupported(c, k, o);
+            if (why != null) {
+                out.add(new Result(id, kind, "unsupported", null, verified, why, c, f));
+                continue;
+            }
+            Map<String, Object> actual;
+            try {
+                actual = k.actual(c);
+            } catch (Throwable e) {
+                out.add(new Result(id, kind, "error", null, verified, e.getClass().getSimpleName() + ": " + e.getMessage(), c, f));
+                continue;
+            }
+            List<String> reasons = new ArrayList<>();
+            Map<String, Object> expect = CoreKinds.map(c.get("expect"));
+            Map<String, Object> tolerance = expect.get("tolerance") instanceof Map<?, ?> ? CoreKinds.map(expect.get("tolerance"))
+                    : c.get("tolerance") instanceof Map<?, ?> ? CoreKinds.map(c.get("tolerance")) : null;
+            boolean pass = Expect.matches(expect, actual, tolerance, reasons);
+            out.add(new Result(id, kind, pass ? "pass" : "fail", actual, verified, String.join("; ", reasons), c, f));
+        }
+        return out;
+    }
+
+    static String unsupported(Map<String, Object> c, KindRunner k, Options o) {
+        if (k == null) {
+            return "kind " + c.get("kind") + " is not run here";
+        }
+        Object p = c.get("profile");
+        List<?> profiles = p instanceof List<?> l ? l : List.of(String.valueOf(p));
+        for (Object name : profiles) {
+            if (!o.profiles().contains(String.valueOf(name))) {
+                return "profile " + name + " is not loaded";
+            }
+        }
+        if (minor(String.valueOf(c.get("since"))) > minor(o.language())) {
+            return "since " + c.get("since") + " is later than language " + o.language();
+        }
+        return null;
+    }
+
+    static int minor(String v) {
+        String[] parts = v.split("\\.");
+        return Integer.parseInt(parts[0]) * 1000 + (parts.length > 1 ? Integer.parseInt(parts[1]) : 0);
+    }
+
+    static boolean glob(String g, String id) {
+        String rx = Pattern.quote(g.replace("**", "*")).replace("*", "\\E.*\\Q").replace("?", "\\E.\\Q");
+        return id.matches(rx);
+    }
+
+    /** RUNNER 2: the parts of the schema a runner relies on; the full JSON Schema is checked by the Rachana driver in its CI. */
+    static Map<String, Object> check(CaseSource.SuiteFile f) {
+        Object read;
+        try {
+            read = CaseYaml.read(f.text());
+        } catch (RuntimeException e) {
+            throw new IllegalStateException(f.suite() + ": not a case file: " + e.getMessage(), e);
+        }
+        Map<String, Object> doc = CoreKinds.map(read);
+        String where = f.suite() + ": ";
+        if (!f.suite().equals(doc.get("suite"))) {
+            throw new IllegalStateException(where + "suite " + doc.get("suite") + " is not " + f.suite());
+        }
+        if (!(doc.get("since") instanceof String) || doc.get("profile") == null) {
+            throw new IllegalStateException(where + "'since' (quoted) and 'profile' are required");
+        }
+        if (!(doc.get("cases") instanceof List<?> cases) || cases.isEmpty()) {
+            throw new IllegalStateException(where + "'cases' must be a list of at least one case");
+        }
+        Set<String> ids = new HashSet<>();
+        for (Object o : cases) {
+            Map<String, Object> c = CoreKinds.map(o);
+            String id = String.valueOf(c.get("id"));
+            if (!ID.matcher(id).matches() || !ids.add(id)) {
+                throw new IllegalStateException(where + "case id '" + id + "' is malformed or repeated");
+            }
+            if (!KINDS.contains(String.valueOf(c.get("kind")))) {
+                throw new IllegalStateException(where + id + ": unknown kind " + c.get("kind"));
+            }
+            if (!"protocol".equals(c.get("kind")) && CoreKinds.map(c.get("expect")).isEmpty()) {
+                throw new IllegalStateException(where + id + ": 'expect' must name at least one field");
+            }
+        }
+        return doc;
+    }
+
+    /** FORMAT 2 and 3: the file's {@code since}, {@code profile} and {@code verified} unless the case says; {@code given} key by key. */
+    static Map<String, Object> merged(Map<String, Object> doc, Map<String, Object> c) {
+        Map<String, Object> m = new LinkedHashMap<>(c);
+        for (String k : List.of("since", "profile", "verified")) {
+            m.putIfAbsent(k, doc.get(k));
+        }
+        Map<String, Object> g = new LinkedHashMap<>(CoreKinds.map(doc.get("given")));
+        g.putAll(CoreKinds.map(c.get("given")));
+        if (!g.isEmpty()) {
+            m.put("given", g);
+        }
+        m.put("verified", Boolean.TRUE.equals(m.get("verified")));
+        return m;
+    }
+
+    // ---- outputs ---------------------------------------------------------------------------------------------------
+
+    /** RUNNER 4.1 and 4.3: {@code <runtime>.jsonl} and {@code <runtime>.summary.json} in {@code dir}. */
+    public static void write(List<Result> results, Path dir, Options o, String origin, long millis) {
+        StringBuilder lines = new StringBuilder();
+        Map<String, Integer> counts = new LinkedHashMap<>(Map.of("pass", 0, "fail", 0, "error", 0, "unsupported", 0));
+        int unverifiedFailing = 0;
+        List<Object> failures = new ArrayList<>();
+        for (Result r : results) {
+            Map<String, Object> line = new LinkedHashMap<>();
+            line.put("case", r.id());
+            line.put("kind", r.kind());
+            line.put("status", r.status());
+            line.put("actual", r.actual());
+            lines.append(Canonical.of(line)).append('\n');
+            counts.merge(r.status(), 1, Integer::sum);
+            if ("fail".equals(r.status()) || "error".equals(r.status())) {
+                unverifiedFailing += r.verified() ? 0 : 1;
+                Map<String, Object> f = new LinkedHashMap<>();
+                f.put("case", r.id());
+                f.put("status", r.status());
+                f.put("verified", r.verified());
+                f.put("detail", r.detail().length() > 300 ? r.detail().substring(0, 300) : r.detail());
+                failures.add(f);
+            }
+        }
+        Map<String, Object> summary = new LinkedHashMap<>();
+        summary.put("runtime", o.runtime());
+        summary.put("runtimeVersion", "drishti " + System.getProperty("drishti.version", "tree"));
+        summary.put("cases-from", origin);
+        summary.put("language", o.language());
+        summary.put("profiles", List.copyOf(new java.util.TreeSet<>(o.profiles())));
+        summary.put("cases", (long) results.size());
+        counts.forEach((k, v) -> summary.put(k, (long) v));
+        summary.put("unverifiedFailing", (long) unverifiedFailing);
+        summary.put("failures", failures);
+        summary.put("millis", millis);
+        try {
+            Files.createDirectories(dir);
+            Files.writeString(dir.resolve(o.runtime() + ".jsonl"), lines.toString(), StandardCharsets.UTF_8);
+            Files.writeString(dir.resolve(o.runtime() + ".summary.json"), Canonical.of(summary) + "\n", StandardCharsets.UTF_8);
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+
+    // ---- record mode (RUNNER 6) ------------------------------------------------------------------------------------
+
+    /**
+     * Writes the reference's actual document into {@code expect} of every unverified case that ran, keeping the fields the case
+     * names (every field when it names none). Only a one-line flow {@code expect: {...}} is rewritten; comments, order and layout
+     * stay. {@code verified} is never changed: a person reviews the diff and flips it.
+     *
+     * @return the number of {@code expect} lines rewritten
+     */
+    public static int record(List<Result> results) {
+        Map<Path, Map<String, Map<String, Object>>> per = new LinkedHashMap<>();
+        for (Result r : results) {
+            if (r.verified() || r.actual() == null || r.file() == null || r.file().file() == null) {
+                continue;
+            }
+            Map<String, Object> expect = CoreKinds.map(r.c().get("expect"));
+            Map<String, Object> rec = new LinkedHashMap<>();
+            for (String k : (expect.isEmpty() ? r.actual() : expect).keySet()) {
+                if (r.actual().containsKey(k) && !"tolerance".equals(k)) {
+                    rec.put(k, r.actual().get(k));
+                }
+            }
+            per.computeIfAbsent(r.file().file(), x -> new LinkedHashMap<>()).put(String.valueOf(r.c().get("id")), rec);
+        }
+        int n = 0;
+        Pattern caseLine = Pattern.compile("^\\s*- id: \"?([a-z0-9-]+)\"?\\s*$");
+        Pattern expectLine = Pattern.compile("^(\\s{4})expect: \\{.*\\}\\s*$");
+        for (Map.Entry<Path, Map<String, Map<String, Object>>> e : per.entrySet()) {
+            try {
+                List<String> lines = new ArrayList<>(List.of(Files.readString(e.getKey(), StandardCharsets.UTF_8).split("\n", -1)));
+                for (int i = 0; i < lines.size(); i++) {
+                    var m = caseLine.matcher(lines.get(i));
+                    if (m.matches() && e.getValue().containsKey(m.group(1))) {
+                        for (int j = i + 1; j < lines.size() && !lines.get(j).matches("^\\s*- id:.*"); j++) {
+                            var x = expectLine.matcher(lines.get(j));
+                            if (x.matches()) {
+                                lines.set(j, x.group(1) + "expect: " + flow(e.getValue().get(m.group(1))));
+                                n++;
+                                break;
+                            }
+                        }
+                    }
+                }
+                Files.writeString(e.getKey(), String.join("\n", lines), StandardCharsets.UTF_8);
+            } catch (IOException ex) {
+                throw new UncheckedIOException(ex);
+            }
+        }
+        return n;
+    }
+
+    /** A flow mapping a case author reads: JSON, with a number in N3 form written with a small {@code e} ({@code 1.0e20}). */
+    static String flow(Object v) {
+        if (v instanceof Number num) {
+            return Canonical.number(num).replace("E", "e");
+        }
+        if (v instanceof Map<?, ?> m) {
+            StringBuilder b = new StringBuilder("{");
+            boolean first = true;
+            for (Map.Entry<?, ?> e : m.entrySet()) {
+                if (!first) {
+                    b.append(", ");
+                }
+                first = false;
+                Canonical.string(String.valueOf(e.getKey()), b);
+                b.append(": ").append(flow(e.getValue()));
+            }
+            return b.append('}').toString();
+        }
+        if (v instanceof List<?> l) {
+            List<String> parts = new ArrayList<>();
+            l.forEach(x -> parts.add(flow(x)));
+            return "[" + String.join(", ", parts) + "]";
+        }
+        return Canonical.of(v);
+    }
+}
