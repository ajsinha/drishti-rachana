<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.ash.rachana</groupId><artifactId>rachana-parent</artifactId><version>1.1.1</version></parent>
  <artifactId>rachana-guards</artifactId>
  <name>rachana-guards</name>
  <description>Test-only module: source-scan guards over the whole reactor. Not released.</description>
  <dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <properties>
    <node>node</node>
    <rachana.node.skip>false</rachana.node.skip>
    <uv>uv</uv>
  </properties>
  <profiles>
    <!-- -DskipTests (or -Dmaven.test.skip=true) leaves out every test of this module: the Node tests and the lanes below (exec-maven-plugin does not read skipTests). -->
    <profile>
      <id>skip-tests</id>
      <activation><property><name>skipTests</name><value>true</value></property></activation>
      <properties><rachana.node.skip>true</rachana.node.skip><rachana.lanes.skip>true</rachana.lanes.skip></properties>
    </profile>
    <profile>
      <id>skip-maven-test</id>
      <activation><property><name>maven.test.skip</name><value>true</value></property></activation>
      <properties><rachana.node.skip>true</rachana.node.skip><rachana.lanes.skip>true</rachana.lanes.skip></properties>
    </profile>
  </profiles>
  <build>
    <plugins>
      <plugin><artifactId>maven-jar-plugin</artifactId><configuration><skipIfEmpty>true</skipIfEmpty></configuration></plugin>
      <plugin><artifactId>maven-install-plugin</artifactId><configuration><skip>true</skip></configuration></plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <rachana.java.root>${rachana.java.root}</rachana.java.root>
            <rachana.repo.root>${rachana.repo.root}</rachana.repo.root>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- the Node tests of the runtime, the command line and the Studio run with every build (so they cannot rot unseen). The Java-dependent
           ones find the classes of the earlier modules (this module is last); the bundle-dependent ones need js/packages/rachana/dist
           (rachana-js builds the bundles and copies them there before this module runs; the run FAILS, never skips quietly, when they are missing or a test was skipped). Node 20+ on the PATH, or -Dnode=/path/to/node; -Drachana.node.skip=true leaves them out.
           The lanes (phase verify, tools/gate/verify_lanes.py: conformance at every level on the JVM and Node, the protocol cases on all hosts, the Python SDK tests, a Chromium
           lane) need uv and run with nothing skipped; -Drachana.lanes.skip=true or -DskipTests leaves them out. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.6.3</version>
        <executions>
          <execution><id>node-tests</id><phase>test</phase><goals><goal>exec</goal></goals><configuration>
            <skip>${rachana.node.skip}</skip>
            <environmentVariables><TMPDIR>${rachana.tmp}</TMPDIR><TEMP>${rachana.tmp}</TEMP><TMP>${rachana.tmp}</TMP></environmentVariables>
            <executable>${node}</executable>
            <workingDirectory>${rachana.repo.root}</workingDirectory>
            <arguments><argument>tools/js/node_tests.mjs</argument><argument>js/packages/*/test</argument></arguments>
          </configuration></execution>
          <execution><id>lane-conformance</id><phase>verify</phase><goals><goal>exec</goal></goals><configuration>
            <skip>${rachana.lanes.skip}</skip>
            <environmentVariables><TMPDIR>${rachana.tmp}</TMPDIR><TEMP>${rachana.tmp}</TEMP><TMP>${rachana.tmp}</TMP></environmentVariables>
            <executable>${uv}</executable>
            <workingDirectory>${rachana.repo.root}</workingDirectory>
            <arguments>
              <argument>run</argument><argument>-q</argument><argument>--with</argument><argument>pyyaml&gt;=6</argument><argument>--with</argument><argument>jsonschema&gt;=4</argument>
              <argument>--with</argument><argument>pyarrow&gt;=15</argument><argument>python</argument><argument>tools/gate/verify_lanes.py</argument>
              <argument>conformance</argument><argument>--java-home</argument><argument>${java.home}</argument>
            </arguments>
          </configuration></execution>
          <execution><id>lane-protocol</id><phase>verify</phase><goals><goal>exec</goal></goals><configuration>
            <skip>${rachana.lanes.skip}</skip>
            <environmentVariables><TMPDIR>${rachana.tmp}</TMPDIR><TEMP>${rachana.tmp}</TEMP><TMP>${rachana.tmp}</TMP></environmentVariables>
            <executable>${uv}</executable>
            <workingDirectory>${rachana.repo.root}</workingDirectory>
            <arguments>
              <argument>run</argument><argument>-q</argument><argument>--with</argument><argument>pyyaml&gt;=6</argument><argument>--with</argument><argument>jsonschema&gt;=4</argument>
              <argument>--with</argument><argument>pyarrow&gt;=15</argument><argument>python</argument><argument>tools/gate/verify_lanes.py</argument>
              <argument>protocol</argument><argument>--java-home</argument><argument>${java.home}</argument>
            </arguments>
          </configuration></execution>
          <execution><id>lane-pytest</id><phase>verify</phase><goals><goal>exec</goal></goals><configuration>
            <skip>${rachana.lanes.skip}</skip>
            <environmentVariables><TMPDIR>${rachana.tmp}</TMPDIR><TEMP>${rachana.tmp}</TEMP><TMP>${rachana.tmp}</TMP></environmentVariables>
            <executable>${uv}</executable>
            <workingDirectory>${rachana.repo.root}</workingDirectory>
            <arguments>
              <argument>run</argument><argument>-q</argument><argument>--with</argument><argument>pyyaml&gt;=6</argument><argument>--with</argument><argument>jsonschema&gt;=4</argument>
              <argument>--with</argument><argument>pyarrow&gt;=15</argument><argument>python</argument><argument>tools/gate/verify_lanes.py</argument>
              <argument>pytest</argument><argument>--java-home</argument><argument>${java.home}</argument>
            </arguments>
          </configuration></execution>
          <execution><id>lane-browser</id><phase>verify</phase><goals><goal>exec</goal></goals><configuration>
            <skip>${rachana.lanes.skip}</skip>
            <environmentVariables><TMPDIR>${rachana.tmp}</TMPDIR><TEMP>${rachana.tmp}</TEMP><TMP>${rachana.tmp}</TMP></environmentVariables>
            <executable>${uv}</executable>
            <workingDirectory>${rachana.repo.root}</workingDirectory>
            <arguments>
              <argument>run</argument><argument>-q</argument><argument>--with</argument><argument>pyyaml&gt;=6</argument><argument>--with</argument><argument>jsonschema&gt;=4</argument>
              <argument>--with</argument><argument>pyarrow&gt;=15</argument><argument>python</argument><argument>tools/gate/verify_lanes.py</argument>
              <argument>browser</argument><argument>--java-home</argument><argument>${java.home}</argument>
            </arguments>
          </configuration></execution>
          <execution><id>tmp-check</id><phase>verify</phase><goals><goal>exec</goal></goals><configuration>
            <skip>${rachana.lanes.skip}</skip>
            <executable>${python3}</executable>
            <arguments><argument>${rachana.repo.root}/tools/gate/tmp_leaks.py</argument><argument>check</argument><argument>${rachana.tmp}</argument></arguments>
          </configuration></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
