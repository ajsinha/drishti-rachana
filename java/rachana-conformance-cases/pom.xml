<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.ash.rachana</groupId><artifactId>rachana-parent</artifactId><version>0.10.0-SNAPSHOT</version></parent>
  <artifactId>rachana-conformance-cases</artifactId>
  <name>rachana-conformance-cases</name>
  <description>Cases and specification only: YAML, JSON and Markdown, no code (decision N4). Licensed under LICENSE-SPEC.md.</description>
  <!-- No Java sources and no dependencies. The jar holds conformance/ at conformance/ and spec/ at spec/. -->
  <build>
    <resources>
      <resource><directory>${rachana.repo.root}/conformance</directory><targetPath>conformance</targetPath></resource>
      <resource><directory>${rachana.repo.root}/spec</directory><targetPath>spec</targetPath></resource>
      <resource><directory>${rachana.repo.root}</directory><targetPath>META-INF</targetPath><includes><include>LICENSE-SPEC.md</include></includes></resource>
    </resources>
    <plugins>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration><skipIfEmpty>false</skipIfEmpty><forceCreation>true</forceCreation></configuration>
      </plugin>
    </plugins>
  </build>
</project>
