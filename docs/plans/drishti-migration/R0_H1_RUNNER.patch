+package com.ash.drishti.rachana.conformance;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.net.URI;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.FileSystem;
+import java.nio.file.FileSystems;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Stream;
+
+/**
+ * Where the conformance cases and the specification are read from (Rachana plan N4). By default the <b>pinned cases jar</b>
+ * ({@code com.ash.rachana:rachana-conformance-cases:${drishti.rachana.version}}, a test dependency resolved from the committed file
+ * repository {@code packaging/pinned/maven}); a builder iterating on cases points the runner at a checkout of drishti-rachana instead
+ * with the test-only property {@code rachana.conformance.cases} (an absolute path: the checkout's root, or its {@code conformance/1}),
+ * the only way record mode can write {@code expect} back.
+ *
+ * @param root the folder that holds {@code conformance/} and {@code spec/} (a folder of the jar's file system, or of the checkout)
+ * @param origin what it is, for reports: {@code jar <version> (<commit>)} or {@code checkout <path>}
+ * @param writable whether the files may be rewritten (a checkout)
+ */
+public record CaseSource(Path root, String origin, boolean writable) {
+
+    /** The test-only property naming a checkout of drishti-rachana (N4). */
+    public static final String PROPERTY = "rachana.conformance.cases";
+    /** The resource every cases jar carries: artefact, version, commit and the number of cases. */
+    public static final String STAMP = "META-INF/rachana-cases.json";
+
+    /** One case file: its suite name ({@code el/math}), its text and, for a checkout, the file. */
+    public record SuiteFile(String suite, String text, Path file) {}
+
+    /** The checkout the property names, else the pinned jar on the test class path. */
+    public static CaseSource resolve() {
+        String dir = System.getProperty(PROPERTY, System.getenv().getOrDefault("RACHANA_CONFORMANCE_CASES", ""));
+        if (!dir.isBlank()) {
+            Path p = Path.of(dir);
+            if (!p.isAbsolute()) {
+                throw new IllegalStateException(PROPERTY + " must be an absolute path to a drishti-rachana checkout, not '" + dir + "'");
+            }
+            Path root = Files.isDirectory(p.resolve("conformance/1")) ? p : p.getParent() != null && p.endsWith(Path.of("conformance", "1")) ? p.getParent().getParent() : null;
+            if (root == null || !Files.isDirectory(root.resolve("spec/1"))) {
+                throw new IllegalStateException(PROPERTY + "=" + dir + " is not a drishti-rachana checkout (no conformance/1 and spec/1)");
+            }
+            return new CaseSource(root.toAbsolutePath().normalize(), "checkout " + root.toAbsolutePath().normalize(), true);
+        }
+        URL stamp = CaseSource.class.getClassLoader().getResource(STAMP);
+        if (stamp == null || !"jar".equals(stamp.getProtocol())) {
+            throw new IllegalStateException("no pinned cases jar on the test class path (" + STAMP + " not found in a jar): the dependency "
+                    + "com.ash.rachana:rachana-conformance-cases:${drishti.rachana.version} reads packaging/pinned/maven");
+        }
+        try {
+            String s = stamp.toString();
+            URI jar = URI.create(s.substring(0, s.indexOf("!/")));
+            FileSystem fs;
+            try {
+                fs = FileSystems.newFileSystem(jar, Map.of());
+            } catch (java.nio.file.FileSystemAlreadyExistsException e) {
+                fs = FileSystems.getFileSystem(jar);
+            }
+            Path root = fs.getPath("/");
+            Map<String, Object> st = CoreKinds.map(CaseYaml.read(Files.readString(root.resolve(STAMP), StandardCharsets.UTF_8)));
+            String commit = String.valueOf(st.get("commit"));
+            return new CaseSource(root, "jar " + st.get("version") + " (" + commit.substring(0, Math.min(12, commit.length())) + ")", false);
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+
+    /** Every {@code *.yaml} below {@code conformance/1}, in the byte order of the suite names' UTF-8 (RUNNER 2). */
+    public List<SuiteFile> files() {
+        Path suiteRoot = root.resolve("conformance").resolve("1");
+        List<SuiteFile> out = new ArrayList<>();
+        try (Stream<Path> s = Files.walk(suiteRoot)) {
+            for (Path p : s.filter(f -> f.getFileName() != null && f.getFileName().toString().endsWith(".yaml") && Files.isRegularFile(f)).toList()) {
+                String rel = suiteRoot.relativize(p).toString().replace('\\', '/');
+                out.add(new SuiteFile(rel.substring(0, rel.length() - ".yaml".length()), Files.readString(p, StandardCharsets.UTF_8), writable ? p : null));
+            }
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+        out.sort(Comparator.comparing(f -> new String(f.suite().getBytes(StandardCharsets.UTF_8), StandardCharsets.ISO_8859_1)));
+        return out;
+    }
+
+    /** A file of {@code spec/1} ({@code formats.yaml}), as text. */
+    public String spec(String name) {
+        try {
+            return Files.readString(root.resolve("spec").resolve("1").resolve(name), StandardCharsets.UTF_8);
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+}
