<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.ash.rachana</groupId>
  <artifactId>rachana-parent</artifactId>
  <version>0.11.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Drishti Rachana (reactor)</name>

  <modules>
    <module>rachana-api</module>
    <module>rachana-core</module>
    <module>rachana-tools</module>
    <module>rachana-data</module>
    <module>rachana-live</module>
    <module>rachana-server</module>
    <module>rachana-cli</module>
    <module>rachana-conformance</module>
    <module>rachana-conformance-cases</module>
    <module>rachana-compat</module>
    <module>rachana-guards</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    <junit.version>5.11.4</junit.version>
    <!-- The pinned Drishti Elements release whose data files (formats, world regions) Core bundles: js/vendor/drishti-elements/<this>/ -->
    <drishti.elements.version>2.4.0</drishti.elements.version>
    <!-- SPLIT EXEMPTIONS (SPLIT_EXEMPTIONS.md): versions of the libraries the moved code still uses; each leaves at its step. -->
    <assertj.version>3.27.7</assertj.version>
    <!-- Explicit anchors: java/ is this pom's folder, the repository root is one above it. -->
    <rachana.reference.classpath></rachana.reference.classpath>
    <rachana.compat.runtime>core</rachana.compat.runtime>
    <rachana.java.root>${maven.multiModuleProjectDirectory}</rachana.java.root>
    <rachana.repo.root>${maven.multiModuleProjectDirectory}/..</rachana.repo.root>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId><artifactId>junit-bom</artifactId><version>${junit.version}</version>
        <type>pom</type><scope>import</scope>
      </dependency>
      <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><version>${assertj.version}</version></dependency>
    </dependencies>
  </dependencyManagement>

  <!-- The JavaScript build (split step A15): TeaVM, only with -Pjs, so the JVM build needs no TeaVM. -->
  <profiles>
    <profile>
      <id>js</id>
      <modules><module>rachana-js</module></modules>
    </profile>
  </profiles>

  <!-- Design rule: no Spring, no Jackson, no Caffeine, no logging framework in any module (COMPILER_AND_RUNTIMES 3.2).
       The enforcer below and rachana-guards (DependencyAllowListTest) both say so. -->
  <build>
    <pluginManagement>
      <plugins>
        <plugin><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
        <plugin><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version></plugin>
        <plugin><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version></plugin>
        <plugin><artifactId>maven-install-plugin</artifactId><version>3.1.3</version></plugin>
        <plugin><artifactId>maven-enforcer-plugin</artifactId><version>3.5.0</version></plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-rules</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[21,)</version></requireJavaVersion>
                <bannedDependencies>
                  <!-- SPLIT EXEMPTIONS (SPLIT_EXEMPTIONS.md): allowed only until the named step; this list only shrinks. -->
                  <includes>
                  </includes>
                  <excludes>
                    <exclude>org.springframework*:*</exclude>
                    <exclude>com.fasterxml.jackson*:*</exclude>
                    <exclude>com.github.ben-manes.caffeine:*</exclude>
                    <exclude>org.slf4j:*</exclude>
                    <exclude>com.ash.drishti*:*</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
