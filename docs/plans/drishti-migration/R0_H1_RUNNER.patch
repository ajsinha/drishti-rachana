+package com.ash.drishti.rachana.conformance;
+
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Canonical JSON of the conformance suite (Rachana {@code conformance/FORMAT.md} sections 8 and 9) over plain Java values: null,
+ * {@link Boolean}, {@link Number}, {@link String}, {@link List} and {@link Map} (kept in its order). Two documents are "the same"
+ * exactly when this text is the same; every comparison of the runner goes through it, as the Rachana driver's does.
+ */
+public final class Canonical {
+
+    private Canonical() {}
+
+    /** The canonical text of a value. */
+    public static String of(Object v) {
+        StringBuilder sb = new StringBuilder();
+        write(v, sb);
+        return sb.toString();
+    }
+
+    static void write(Object v, StringBuilder sb) {
+        switch (v) {
+            case null -> sb.append("null");
+            case Boolean b -> sb.append(b);
+            case Number n -> sb.append(number(n));
+            case String s -> string(s, sb);
+            case Map<?, ?> m -> {
+                sb.append('{');
+                boolean first = true;
+                for (Map.Entry<?, ?> e : m.entrySet()) {
+                    if (!first) {
+                        sb.append(',');
+                    }
+                    first = false;
+                    string(String.valueOf(e.getKey()), sb);
+                    sb.append(':');
+                    write(e.getValue(), sb);
+                }
+                sb.append('}');
+            }
+            case List<?> l -> {
+                sb.append('[');
+                for (int i = 0; i < l.size(); i++) {
+                    if (i > 0) {
+                        sb.append(',');
+                    }
+                    write(l.get(i), sb);
+                }
+                sb.append(']');
+            }
+            default -> throw new IllegalArgumentException("not a JSON value: " + v.getClass().getName());
+        }
+    }
+
+    /**
+     * FORMAT 9: every number is read as the double it denotes and printed N1 (a whole number below 10^15 as its digits), N2 (plain,
+     * 10^-3 to 10^7) or N3 (scientific); negative zero is {@code 0}. Java 21's {@code Double.toString} is the shortest form FORMAT 9
+     * pins, plain exactly in N2's range.
+     */
+    public static String number(Number n) {
+        double x = n.doubleValue();
+        if (Double.isNaN(x)) {
+            return "NaN";
+        }
+        if (Double.isInfinite(x)) {
+            return x > 0 ? "Infinity" : "-Infinity";
+        }
+        if (x == 0) {
+            return "0";
+        }
+        if (x == Math.rint(x) && Math.abs(x) < 1e15) {
+            return Long.toString((long) x);
+        }
+        return Double.toString(x);
+    }
+
+    /** FORMAT 8 rule 3. */
+    public static void string(String s, StringBuilder b) {
+        b.append('"');
+        for (int i = 0; i < s.length(); i++) {
+            char ch = s.charAt(i);
+            switch (ch) {
+                case '"' -> b.append("\\\"");
+                case '\\' -> b.append("\\\\");
+                case '\b' -> b.append("\\b");
+                case '\t' -> b.append("\\t");
+                case '\n' -> b.append("\\n");
+                case '\f' -> b.append("\\f");
+                case '\r' -> b.append("\\r");
+                default -> {
+                    boolean lone = Character.isSurrogate(ch)
+                            && !(Character.isHighSurrogate(ch) && i + 1 < s.length() && Character.isLowSurrogate(s.charAt(i + 1)))
+                            && !(Character.isLowSurrogate(ch) && i > 0 && Character.isHighSurrogate(s.charAt(i - 1)));
+                    if (ch < 0x20 || ch == 0x7f || lone) {
+                        b.append(String.format("\\u%04x", (int) ch));
+                    } else {
+                        b.append(ch);
+                    }
+                }
+            }
+        }
+        b.append('"');
+    }
+}
