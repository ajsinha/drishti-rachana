+ * See the LICENSE file in the root of this repository for the full terms.
+ */
+package com.ash.drishti.rachana.conformance;
+
+import java.math.BigInteger;
+import java.util.regex.Pattern;
+import org.yaml.snakeyaml.LoaderOptions;
+import org.yaml.snakeyaml.Yaml;
+import org.yaml.snakeyaml.constructor.AbstractConstruct;
+import org.yaml.snakeyaml.constructor.SafeConstructor;
+import org.yaml.snakeyaml.nodes.Node;
+import org.yaml.snakeyaml.nodes.ScalarNode;
+import org.yaml.snakeyaml.nodes.Tag;
+import org.yaml.snakeyaml.representer.Representer;
+import org.yaml.snakeyaml.resolver.Resolver;
+import org.yaml.snakeyaml.DumperOptions;
+
+/**
+ * Reads a case file as FORMAT section 2 says: one YAML 1.2 document under the <em>core</em> schema (only {@code true}/{@code false}
+ * are booleans, only {@code null}/{@code ~}/empty is null, {@code 2026-01-15} and {@code yes} stay text, {@code 1e20} is a number),
+ * no repeated key, mapping order kept. The same rules as the Rachana driver's {@code CoreLoader}; values come back as plain Java
+ * values ({@link Long} or {@link BigInteger}, {@link Double}, {@link String}, {@link Boolean}, lists and ordered maps).
+ */
+public final class CaseYaml {
+
+    private CaseYaml() {}
+
+    /** The one document of {@code text}. */
+    public static Object read(String text) {
+        LoaderOptions options = new LoaderOptions();
+        options.setAllowDuplicateKeys(false);
+        options.setMaxAliasesForCollections(10_000);
+        options.setAllowRecursiveKeys(false);
+        Yaml yaml = new Yaml(new CoreConstructor(options), new Representer(new DumperOptions()), new DumperOptions(), options, new CoreResolver());
+        return yaml.load(text);
+    }
+
+    /** YAML 1.2 core schema tags (spec 10.3.2), nothing else implicit: no timestamps, no merge keys, no YAML 1.1 booleans. */
+    static final class CoreResolver extends Resolver {
+        @Override
+        protected void addImplicitResolvers() {
+            addImplicitResolver(Tag.NULL, Pattern.compile("^(?:~|null|)$"), "~n\0");
+            addImplicitResolver(Tag.BOOL, Pattern.compile("^(?:true|false)$"), "tf");
+            addImplicitResolver(Tag.INT, Pattern.compile("^(?:[-+]?[0-9]+|0o[0-7]+|0x[0-9a-fA-F]+)$"), "-+0123456789");
+            addImplicitResolver(Tag.FLOAT, Pattern.compile(
+                    "^(?:[-+]?(?:\\.[0-9]+|[0-9]+(?:\\.[0-9]*)?)(?:[eE][-+]?[0-9]+)?|[-+]?\\.(?:inf|Inf|INF)|\\.(?:nan|NaN|NAN))$"), "-+0123456789.");
+        }
+    }
+
+    /** Integers in decimal (no YAML 1.1 octal for a leading zero), {@code 0o} and {@code 0x}; floats by {@link Double#parseDouble}. */
+    static final class CoreConstructor extends SafeConstructor {
+        CoreConstructor(LoaderOptions options) {
+            super(options);
+            yamlConstructors.put(Tag.INT, new AbstractConstruct() {
+                @Override
+                public Object construct(Node node) {
+                    String v = ((ScalarNode) node).getValue();
+                    BigInteger b = v.startsWith("0o") ? new BigInteger(v.substring(2), 8)
+                            : v.startsWith("0x") ? new BigInteger(v.substring(2), 16) : new BigInteger(v.startsWith("+") ? v.substring(1) : v);
+                    return b.bitLength() < 64 ? (Object) b.longValue() : b;
+                }
+            });
+            yamlConstructors.put(Tag.FLOAT, new AbstractConstruct() {
+                @Override
+                public Object construct(Node node) {
+                    String v = ((ScalarNode) node).getValue().toLowerCase(java.util.Locale.ROOT);
+                    return switch (v) {
+                        case ".inf", "+.inf" -> Double.POSITIVE_INFINITY;
+                        case "-.inf" -> Double.NEGATIVE_INFINITY;
+                        case ".nan" -> Double.NaN;
+                        default -> Double.parseDouble(v);
+                    };
+                }
+            });
+        }
+    }
+}
