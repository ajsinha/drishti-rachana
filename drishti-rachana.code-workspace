//
// Drishti Rachana in VS Code: File, Open Workspace from File. The tasks and launch configurations below mirror the JetBrains run
// configurations (java/run-configs, python/run-configs, js/run-configs). JDK 21 for the Java extension: change the path below
// (Windows: C:\\jdk-21). Build and run in the IDE: java/README.md#build-and-run-in-the-ide.
{
  "folders": [ { "name": "rachana", "path": "." } ],
  "extensions": {
    "recommendations": [
      "vscjava.vscode-java-pack",
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-python.debugpy",
      "dbaeumer.vscode-eslint",
      "redhat.vscode-yaml"
    ]
  },
  "settings": {
    "java.configuration.runtimes": [
      { "name": "JavaSE-21", "path": "/usr/lib/jvm/java-21-openjdk-amd64", "default": true }
    ],
    "java.jdt.ls.java.home": "/usr/lib/jvm/java-21-openjdk-amd64",
    "java.import.maven.enabled": true,
    "java.configuration.updateBuildConfiguration": "automatic",
    "python.defaultInterpreterPath": "python3",
    "python.analysis.extraPaths": [ "${workspaceFolder:rachana}/python/src" ],
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [ "python/tests" ],
    "python.testing.cwd": "${workspaceFolder:rachana}/python",
    "terminal.integrated.env.linux": { "PYTHONPATH": "${workspaceFolder:rachana}/python/src" },
    "terminal.integrated.env.osx": { "PYTHONPATH": "${workspaceFolder:rachana}/python/src" },
    "terminal.integrated.env.windows": { "PYTHONPATH": "${workspaceFolder:rachana}\\python\\src" },
    "files.associations": { "*.sutra.yaml": "yaml" }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      { "label": "Rachana build all", "type": "shell", "command": "./mvnw clean verify -DskipTests", "windows": { "command": "mvnw.cmd clean verify -DskipTests" },
        "options": { "cwd": "${workspaceFolder:rachana}/java" }, "group": "build", "problemMatcher": [] },
      { "label": "Rachana test", "type": "shell", "command": "./mvnw clean verify", "windows": { "command": "mvnw.cmd clean verify" },
        "options": { "cwd": "${workspaceFolder:rachana}/java" }, "group": "test", "problemMatcher": [] },
      { "label": "Rachana install release (ONLY on a release tag)", "type": "shell", "command": "./mvnw clean install -DskipTests", "windows": { "command": "mvnw.cmd clean install -DskipTests" },
        "options": { "cwd": "${workspaceFolder:rachana}/java" }, "problemMatcher": [] },
      { "label": "Rachana JS bundles (Maven)", "type": "shell", "command": "./mvnw clean package -Pjs -DskipTests -pl :rachana-js -am", "windows": { "command": "mvnw.cmd clean package -Pjs -DskipTests -pl :rachana-js -am" },
        "options": { "cwd": "${workspaceFolder:rachana}/java" }, "problemMatcher": [] },
      { "label": "Rachana JS runtime bundle (build_js.py)", "type": "shell", "command": "python3 tools/js/build_js.py", "windows": { "command": "python tools/js/build_js.py" },
        "options": { "cwd": "${workspaceFolder:rachana}" }, "problemMatcher": [] },
      { "label": "Rachana Node tests", "type": "shell", "command": "node tools/js/node_tests.mjs \"js/packages/*/test\"",
        "options": { "cwd": "${workspaceFolder:rachana}" }, "group": "test", "problemMatcher": [] },
      { "label": "Rachana Python tests", "type": "shell", "command": "python3 -m pytest -q python/tests", "windows": { "command": "python -m pytest -q python/tests" },
        "options": { "cwd": "${workspaceFolder:rachana}" }, "group": "test", "problemMatcher": [] },
      { "label": "Rachana lint examples", "type": "shell", "command": "python3 -m drishti_rachana lint examples/static-sales", "windows": { "command": "python -m drishti_rachana lint examples/static-sales" },
        "options": { "cwd": "${workspaceFolder:rachana}", "env": { "PYTHONPATH": "python/src" } }, "problemMatcher": [] },
      { "label": "Rachana example checks", "type": "shell", "command": "python3 -I examples/check_examples.py", "windows": { "command": "python -I examples/check_examples.py" },
        "options": { "cwd": "${workspaceFolder:rachana}" }, "problemMatcher": [] },
      { "label": "Rachana protocol check (Python host)", "type": "shell", "command": "python3 tools/conformance/protocol_check.py --python", "windows": { "command": "python tools/conformance/protocol_check.py --python" },
        "options": { "cwd": "${workspaceFolder:rachana}", "env": { "PYTHONPATH": "python/src" } }, "problemMatcher": [] },
      { "label": "Rachana Studio (port 4500)", "type": "shell", "command": "node js/packages/rachana-cli/bin/rachana.js studio examples/static-sales --port 4500",
        "options": { "cwd": "${workspaceFolder:rachana}" }, "isBackground": true, "problemMatcher": [] },
      { "label": "Rachana Studio, server-demo (port 4501)", "type": "shell", "command": "node js/packages/rachana-cli/bin/rachana.js studio examples/server-demo/project/sutras --data examples/server-demo/project/data --port 4501",
        "options": { "cwd": "${workspaceFolder:rachana}" }, "isBackground": true, "problemMatcher": [] },
      { "label": "Rachana server check (server-demo)", "type": "shell", "command": "java -jar java/rachana-server/target/rachana-server-0.11.0-SNAPSHOT-all.jar check --config examples/server-demo/rachana-server.yaml",
        "options": { "cwd": "${workspaceFolder:rachana}" }, "problemMatcher": [] },
      { "label": "Rachana server serve (server-demo, port 8090)", "type": "shell", "command": "java -jar java/rachana-server/target/rachana-server-0.11.0-SNAPSHOT-all.jar serve --config examples/server-demo/rachana-server.yaml",
        "options": { "cwd": "${workspaceFolder:rachana}" }, "isBackground": true, "problemMatcher": [] },
      { "label": "Rachana dev server (port 4400)", "type": "shell", "command": "node js/packages/rachana-cli/bin/rachana.js dev examples/static-sales --port 4400",
        "options": { "cwd": "${workspaceFolder:rachana}" }, "isBackground": true, "problemMatcher": [] }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      { "name": "Rachana CLI (lib)", "type": "java", "request": "launch", "mainClass": "com.ash.rachana.cli.Main", "projectName": "rachana-cli",
        "args": "lib contracts", "cwd": "${workspaceFolder:rachana}" },
      { "name": "Rachana reference server (8099)", "type": "java", "request": "launch", "mainClass": "com.ash.rachana.data.ReferenceServer", "projectName": "rachana-data",
        "args": "--port 8099 --base /rdp/v1 --static ${workspaceFolder:rachana}/js/packages/rachana", "cwd": "${workspaceFolder:rachana}" },
      { "name": "Rachana server serve (server-demo)", "type": "java", "request": "launch", "mainClass": "com.ash.rachana.server.Main", "projectName": "rachana-server",
        "args": "serve --config ${workspaceFolder:rachana}/examples/server-demo/rachana-server.yaml", "cwd": "${workspaceFolder:rachana}" },
      { "name": "Rachana server check (server-demo)", "type": "java", "request": "launch", "mainClass": "com.ash.rachana.server.Main", "projectName": "rachana-server",
        "args": "check --config ${workspaceFolder:rachana}/examples/server-demo/rachana-server.yaml", "cwd": "${workspaceFolder:rachana}" },
      { "name": "Rachana server hash-password", "type": "java", "request": "launch", "mainClass": "com.ash.rachana.server.Main", "projectName": "rachana-server",
        "args": "hash-password", "cwd": "${workspaceFolder:rachana}", "console": "integratedTerminal" },
      { "name": "Rachana Studio (server-demo)", "type": "node", "request": "launch", "program": "${workspaceFolder:rachana}/js/packages/rachana-cli/bin/rachana.js",
        "args": [ "studio", "examples/server-demo/project/sutras", "--data", "examples/server-demo/project/data", "--port", "4501" ], "cwd": "${workspaceFolder:rachana}", "console": "integratedTerminal" },
      { "name": "Rachana live-orders (Flask)", "type": "debugpy", "request": "launch", "program": "${workspaceFolder:rachana}/examples/live-orders/flask_app.py",
        "cwd": "${workspaceFolder:rachana}/examples/live-orders", "env": { "PYTHONPATH": "${workspaceFolder:rachana}/python/src" }, "console": "integratedTerminal" },
      { "name": "Rachana live-orders (FastAPI)", "type": "debugpy", "request": "launch", "module": "uvicorn", "args": [ "fastapi_app:app", "--port", "8000" ],
        "cwd": "${workspaceFolder:rachana}/examples/live-orders", "env": { "PYTHONPATH": "${workspaceFolder:rachana}/python/src" }, "console": "integratedTerminal" },
      { "name": "Rachana lint examples", "type": "debugpy", "request": "launch", "module": "drishti_rachana", "args": [ "lint", "examples/static-sales" ],
        "cwd": "${workspaceFolder:rachana}", "env": { "PYTHONPATH": "${workspaceFolder:rachana}/python/src" }, "console": "integratedTerminal" },
      { "name": "Rachana Studio", "type": "node", "request": "launch", "program": "${workspaceFolder:rachana}/js/packages/rachana-cli/bin/rachana.js",
        "args": [ "studio", "examples/static-sales", "--port", "4500" ], "cwd": "${workspaceFolder:rachana}", "console": "integratedTerminal" },
      { "name": "Rachana dev server", "type": "node", "request": "launch", "program": "${workspaceFolder:rachana}/js/packages/rachana-cli/bin/rachana.js",
        "args": [ "dev", "examples/static-sales", "--port", "4400" ], "cwd": "${workspaceFolder:rachana}", "console": "integratedTerminal" }
    ]
  }
}
