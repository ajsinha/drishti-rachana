<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.ash.rachana</groupId><artifactId>rachana-parent</artifactId><version>0.10.0-SNAPSHOT</version></parent>
  <artifactId>rachana-compat</artifactId>
  <name>rachana-compat</name>
  <description>The compatibility regime's gates CG1, CG3, CG4 and CG6 (SUTRA_EXPANSION 6.5): tests and their tooling only, no product code.</description>
  <dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <rachana.repo.root>${maven.multiModuleProjectDirectory}/..</rachana.repo.root>
            <rachana.reference.classpath>${rachana.reference.classpath}</rachana.reference.classpath>
            <rachana.compat.runtime>${rachana.compat.runtime}</rachana.compat.runtime>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
