{
  "name": "publish_ui",
  "implementation": "publish_ui.PublishUiTool",
  "description": "Publish a checked Sutra as a live board page for the user. Give each table's SOURCE, not its rows: a data tool the kit calls itself as the user ({tool, arguments, path}), a Data Protocol host ({protocol, table}), or at most 200 rows you wrote yourself ({rows}). Rows never pass through you.\nReturns {published, board, version, url, tables: {name: {rows}}, fragments, summary}; publishing again with board updates the open page.\nInputs: sutra* (the exact text check_sutra passed), check_token*, tables* ({name: source}), title, board (an id to update).\nExample: {\"sutra\": \"...\", \"check_token\": \"...\", \"tables\": {\"limits\": {\"tool\": \"risk_limits\", \"arguments\": {\"date\": \"2026-11-20\"}, \"path\": \"rows\"}}, \"title\": \"Limits\"}",
  "annotations": {
    "readOnlyHint": false,
    "idempotentHint": false,
    "destructiveHint": false,
    "openWorldHint": false
  },
  "version": "0.1.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "sutra",
      "check_token",
      "tables"
    ],
    "properties": {
      "sutra": {
        "type": "string",
        "maxLength": 65536
      },
      "check_token": {
        "type": "string",
        "maxLength": 128
      },
      "tables": {
        "type": "object",
        "maxProperties": 12,
        "propertyNames": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "additionalProperties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "tool": {
              "type": "string",
              "description": "A data tool on the kit's allow-list, called as the user"
            },
            "arguments": {
              "type": "object",
              "description": "The data tool's arguments"
            },
            "path": {
              "type": "string",
              "description": "Where the rows are in its result, e.g. rows or result.items"
            },
            "protocol": {
              "type": "string",
              "description": "A Data Protocol base address on the kit's allow-list; the page reads it"
            },
            "table": {
              "type": "string",
              "description": "The table's name at that host (default: this name)"
            },
            "rows": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object"
              },
              "description": "Rows you wrote yourself (labels, targets): never a tool's data"
            }
          }
        }
      },
      "title": {
        "type": "string",
        "maxLength": 120
      },
      "board": {
        "type": "string",
        "maxLength": 64,
        "description": "Update this board (its open pages follow)"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "published"
    ],
    "properties": {
      "published": {
        "type": "boolean"
      },
      "board": {
        "type": "string"
      },
      "version": {
        "type": "integer"
      },
      "url": {
        "type": "string"
      },
      "expires_minutes": {
        "type": "integer"
      },
      "tables": {
        "type": "object"
      },
      "fragments": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "summary": {
        "type": "string"
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "table": {
            "type": "string"
          }
        }
      },
      "problems": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "severity",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "description": "RCH-nnnn (the compiler, SPEC 6.2) or RGK-nnn (this kit)"
            },
            "severity": {
              "enum": [
                "error",
                "warning",
                "info"
              ]
            },
            "message": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "description": "JSON Pointer to the node"
            },
            "range": {
              "type": "object"
            },
            "expected": {
              "type": "array",
              "items": {}
            },
            "fix": {
              "type": "object"
            },
            "file": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "metadata": {
    "author": "Ashutosh Sinha",
    "email": "ajsinha@gmail.com",
    "copyright": "Copyright (c) 2026 Ashutosh Sinha. Drishti Rachana; proprietary",
    "category": "Generative UI",
    "tags": [
      "rachana",
      "genui",
      "dashboard",
      "sutra"
    ],
    "pack": "rachana-genui"
  }
}
