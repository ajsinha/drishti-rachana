  Rachana server check (server-demo): rachana-server check: checks examples/server-demo/rachana-server.yaml whole and prints its resolved settings (exit 1 with every problem listed).
  Use it when: you edit a server configuration.
  Application configuration of the module rachana-server; run Rachana JS runtime bundle and then Rachana build all first (the server's page assets are copied into target/classes by the build).
  Shared, so it is in git: copy the configuration (Ctrl+D) to change it; a pull overwrites this file.
-->
<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="Rachana server check (server-demo)" type="Application" factoryName="Application" folderName="Rachana">
    <option name="MAIN_CLASS_NAME" value="com.ash.rachana.server.Main" />
    <module name="rachana-server" />
    <option name="VM_PARAMETERS" value="" />
    <option name="PROGRAM_PARAMETERS" value="check --config $PROJECT_DIR$/../examples/server-demo/rachana-server.yaml" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$/.." />
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
