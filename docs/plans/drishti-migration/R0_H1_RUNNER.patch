+import com.ash.drishti.rachana.el.ElCompiler;
+import com.ash.drishti.rachana.el.ElException;
+import com.ash.drishti.rachana.el.ElLimits;
+import com.ash.drishti.rachana.el.EvalContext;
+import com.ash.drishti.rachana.el.Expr;
+import com.ash.drishti.rachana.el.Link;
+import com.ash.drishti.rachana.el.Template;
+import com.ash.drishti.rachana.el.Values;
+import com.ash.drishti.rachana.format.Formats;
+import com.ash.drishti.rachana.format.Tones;
+import com.ash.drishti.rachana.parse.SutraParser;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * The kinds the reference module answers on its own (FORMAT 5): {@code expr}, {@code expr-error}, {@code format}, {@code problem}
+ * and {@code edit}. Each turns a case into the kind's actual document with Drishti's own compiler, exactly as the Rachana side's
+ * bootstrap bridge ({@code tools/reference-bridge/RefBridge.java}) does over Drishti's jars; the bridge retires when this runner and
+ * the pinned cases are the reference's (plan R0 H1). Codes are written as Core's: {@code DRS-}/{@code DEL-} become {@code RCH-} with
+ * the same number (SPEC 6.2).
+ */
+public final class CoreKinds {
+
+    private static final ObjectMapper JSON = new ObjectMapper();
+    private final ElCompiler el = new ElCompiler();
+    private final Formats formats;
+
+    /** @param formats Core's format table and the Drishti profile's names (the spec's {@code formats.yaml}, then the core pack's) */
+    public CoreKinds(Formats formats) {
+        this.formats = formats;
+    }
+
+    /** The kinds, by name, for {@link ConformanceRun}. */
+    public Map<String, KindRunner> kinds() {
+        Map<String, KindRunner> k = new LinkedHashMap<>();
+        k.put("expr", this::expr);
+        k.put("expr-error", this::exprError);
+        k.put("format", this::format);
+        k.put("problem", this::problem);
+        k.put("edit", this::edit);
+        return k;
+    }
+
+    // ---- expr ------------------------------------------------------------------------------------------------------
+
+    Map<String, Object> expr(Map<String, Object> c) {
+        EvalContext ctx = context(map(c.get("given")));
+        Object v;
+        LinkedHashSet<String> reads = new LinkedHashSet<>();
+        try {
+            if (c.containsKey("template")) {
+                Template t = el.template((String) c.get("template"));
+                v = t.render(ctx);
+                t.paths(reads::add);
+            } else {
+                Expr e = el.compile((String) c.get("expr"));
+                v = e.eval(ctx);
+                e.paths(reads::add);
+            }
+        } catch (DrishtiException e) {
+            Map<String, Object> err = new LinkedHashMap<>();
+            err.put("code", code(e));
+            err.put("message", words(e));
+            return Map.of("error", err);
+        }
+        Object s = Values.simplify(v);
+        Map<String, Object> out = new LinkedHashMap<>();
+        out.put("value", value(s));
+        out.put("type", type(s));
+        out.put("text", Values.masked(s) ? "•••" : Values.text(s));
+        List<Object> rs = new ArrayList<>();
+        reads.forEach(r -> rs.add(r.startsWith("$") ? r : "$." + r));
+        out.put("reads", rs);
+        return out;
+    }
+
+    Map<String, Object> exprError(Map<String, Object> c) {
+        boolean template = c.containsKey("template");
+        String src = (String) (template ? c.get("template") : c.get("expr"));
+        Map<String, Object> limits = map(map(c.get("given")).get("limits"));
+        int depth = limits.get("depth") instanceof Number n ? n.intValue() : 200;
+        int length = limits.get("length") instanceof Number n ? n.intValue() : 10_000;
+        ElCompiler comp = new ElCompiler(1000, new ElLimits(depth, length));
+        List<Object> problems = new ArrayList<>();
+        try {
+            if (template) {
+                comp.template(src);
+            } else {
+                comp.compile(src);
+            }
+        } catch (ElException e) {
+            int at = Math.max(0, e.position());
+            Map<String, Object> p = new LinkedHashMap<>();
+            p.put("code", code(e));
+            p.put("severity", "error");
+            p.put("message", words(e));
+            Map<String, Object> ex = new LinkedHashMap<>();
+            ex.put("source", src);
+            ex.put("start", (long) at);
+            ex.put("end", (long) Math.min(src.length(), at + 1));
+            p.put("expr", ex);
+            problems.add(p);
+        }
+        return Map.of("problems", problems);
+    }
+
+    // ---- format ----------------------------------------------------------------------------------------------------
+
+    Map<String, Object> format(Map<String, Object> c) {
+        Object v = plain(c.get("value"));
+        String text = c.get("format") instanceof String f ? formats.format(f, v) : Values.text(v);
+        String tone = c.get("tone") instanceof String t && !Values.masked(v) ? Tones.resolve(t, v) : null;
+        Map<String, Object> out = new LinkedHashMap<>();
+        out.put("text", text);
+        out.put("tone", tone);
+        return out;
+    }
+
+    // ---- problem ---------------------------------------------------------------------------------------------------
+
+    /** The Sutra is parsed, then its expressions are checked: the problems in the order found. */
+    Map<String, Object> problem(Map<String, Object> c) {
+        List<SutraProblem> ps = new ArrayList<>();
+        String file = c.get("file") instanceof String f ? f : "case.sutra.yaml";
+        try {
+            var sutra = new SutraParser().parse((String) c.get("sutra"), file, "conformance");
+            ps.addAll(new SutraExpressions(new ElCompiler()).check(sutra));
+        } catch (SutraException e) {
+            ps.addAll(e.problems());
+        }
+        List<Object> problems = new ArrayList<>();
+        for (SutraProblem p : ps) {
+            int line = p.location() == null ? 0 : p.location().line();
+            int column = p.location() == null ? 0 : p.location().column();
+            problems.add(problem(p.code(), p.message(), line, column, true));
+        }
+        Map<String, Object> out = new LinkedHashMap<>();
+        out.put("ok", ps.isEmpty());
+        out.put("problems", problems);
+        return out;
+    }
+
+    // ---- edit ------------------------------------------------------------------------------------------------------
+
+    /**
+     * FORMAT 5.11: one editing operation of the reference ({@code design/ops}), its name written in the case in kebab case
+     * ({@code set-option} is {@code setOption}), its fields as the reference names them. Applied, the result is the new text and no
+     * problems; refused, the text unchanged and the reference's problem (its line, when it has one).
+     */
+    Map<String, Object> edit(Map<String, Object> c) {
+        String sutra = (String) c.get("sutra");
+        Map<String, Object> op = new LinkedHashMap<>(map(c.get("operation")));
+        op.put("op", camel((String) op.get("op")));
+        List<Object> problems = new ArrayList<>();
+        String text = sutra;
+        try {
+            OpResult r = new OpApplier().apply(sutra, Ops.parse(JSON.valueToTree(List.of(op))));
+            text = r.yaml();
+            for (OpProblem p : r.problems()) {
+                problems.add(problem(p.code(), p.message(), p.line(), 0, false));
+            }
+        } catch (Ops.FormatException e) {
+            problems.add(problem("DRS-5020", e.getMessage(), 0, 0, false));
+        }
+        Map<String, Object> out = new LinkedHashMap<>();
+        out.put("text", text);
+        out.put("problems", problems);
+        return out;
+    }
+
+    static String camel(String kebab) {
+        StringBuilder b = new StringBuilder();
+        boolean up = false;
+        for (char ch : kebab.toCharArray()) {
+            if (ch == '-') {
+                up = true;
+            } else {
+                b.append(up ? Character.toUpperCase(ch) : ch);
+                up = false;
+            }
+        }
+        return b.toString();
+    }
+
+    /**
+     * SPEC 6.1's shape, the fields the reference has: code, severity, message, and the start of the range: always for a parse problem
+     * (line and column, as the bootstrap bridge writes them), for an editing problem only when the reference knows its line.
+     */
+    static Map<String, Object> problem(String code, String message, int line, int column, boolean located) {
+        Map<String, Object> p = new LinkedHashMap<>();
+        p.put("code", rch(code));
+        p.put("severity", "error");
+        p.put("message", message);
+        if (located || line > 0) {
+            Map<String, Object> start = new LinkedHashMap<>();
+            start.put("line", (long) line);
+            if (located) {
+                start.put("column", (long) column);
+            }
+            p.put("range", Map.of("start", start));
+        }
+        return p;
+    }
+
+    static String rch(String code) {
+        return code == null ? "" : code.replaceFirst("^(DRS|DEL)-", "RCH-");
+    }
+
+    static String words(DrishtiException e) {
+        String m = e.getMessage();
+        String c = e.errorCode() == null ? "" : e.errorCode().code();
+        return m.startsWith(c + " ") ? m.substring(c.length() + 1) : m;
+    }
+
+    static String code(DrishtiException e) {
+        return rch(e.errorCode() == null ? "" : e.errorCode().code());
+    }
+
+    // ---- context ---------------------------------------------------------------------------------------------------
+
+    EvalContext context(Map<String, Object> g) {
+        DataNode root = node(g.containsKey("record") ? g.get("record") : new LinkedHashMap<>());
+        EvalContext c = EvalContext.of(root, formats);
+        if (g.get("today") instanceof String t) {
+            c = c.withToday(LocalDate.parse(t));
+        }
+        if (g.get("ctl") instanceof Map<?, ?> m) {
+            Map<String, Object> ctl = new LinkedHashMap<>();
+            m.forEach((k, v) -> ctl.put(String.valueOf(k), plain(v)));
+            c = c.withControls(ctl);
+        }
+        Map<String, DataNode> events = new LinkedHashMap<>();
+        if (g.get("events") instanceof Map<?, ?> m) {
+            m.forEach((k, v) -> events.put(String.valueOf(k), node(v)));
+        }
+        Object src = g.containsKey("src") ? node(g.get("src")) : null;
+        if (!events.isEmpty() || src != null) {
+            c = c.withScope(new EvalContext.Scope(events, null, src));
+        }
+        List<Object> chain = new ArrayList<>();
+        if (g.get("parents") instanceof List<?> l) {
+            List<Object> ps = new ArrayList<>();
+            l.forEach(p -> ps.add(node(p)));
+            Collections.reverse(ps);
+            chain.addAll(ps);
+        }
+        if (g.containsKey("row")) {
+            chain.add(node(g.get("row")));
+        }
+        if (!chain.isEmpty()) {
+            EvalContext base = c;
+            int idx = g.get("index") instanceof Number n ? n.intValue() : -1;
+            c = new EvalContext(base.root(), base.row(), idx, base.formats(), base.ctl(), base.today(), base.scope(), base.locals()).withRows(chain);
+        }
+        return c;
+    }
+
+    static DataNode node(Object v) {
+        return DataNode.of(plain(v));
+    }
+
+    /** Case values to the reference's values: the tags of FORMAT 4 become a masked node, an exact decimal, NaN or an infinity. */
+    @SuppressWarnings("unchecked")
+    static Object plain(Object v) {
+        if (v == null || v instanceof Boolean || v instanceof String || v instanceof Long || v instanceof Double) {
+            return v;
+        }
+        if (v instanceof BigInteger b) {
+            return b.longValue();
+        }
+        if (v instanceof Number n) {
+            return n.longValue();
+        }
+        if (v instanceof List<?> l) {
+            List<Object> out = new ArrayList<>();
+            l.forEach(x -> out.add(plain(x)));
+            return out;
+        }
+        Map<String, Object> m = (Map<String, Object>) v;
+        if (m.size() == 1 && m.containsKey("$masked")) {
+            return DataNode.masked();
+        }
+        if (m.size() == 1 && m.containsKey("$dec")) {
+            return new BigDecimal(String.valueOf(m.get("$dec")));
+        }
+        if (m.size() == 1 && m.containsKey("$num")) {
+            return switch (String.valueOf(m.get("$num"))) {
+                case "NaN" -> Double.NaN;
+                case "Infinity" -> Double.POSITIVE_INFINITY;
+                default -> Double.NEGATIVE_INFINITY;
+            };
+        }
+        Map<String, Object> out = new LinkedHashMap<>();
+        m.forEach((k, x) -> out.put(k, plain(x)));
+        return out;
+    }
+
+    @SuppressWarnings("unchecked")
+    static Map<String, Object> map(Object v) {
+        return v instanceof Map<?, ?> m ? (Map<String, Object>) m : Map.of();
+    }
+
+    // ---- results ---------------------------------------------------------------------------------------------------
+
+    static String type(Object s) {
+        if (s == null) {
+            return "empty";
+        }
+        if (Values.masked(s)) {
+            return "masked";
+        }
+        return switch (s) {
+            case Boolean b -> "boolean";
+            case BigDecimal d -> "decimal";
+            case Number n -> "number";
+            case String t -> "text";
+            case Link l -> "link";
+            case DataNode d -> "ARRAY".equals(d.type().toString()) ? "list" : "object";
+            case Collection<?> l -> "list";
+            case Map<?, ?> m -> "object";
+            default -> "text";
+        };
+    }
+
+    /** A value as FORMAT 4 writes it: numbers as doubles (N1 to N3), NaN and the infinities and inexact decimals tagged. */
+    static Object value(Object s) {
+        if (s == null) {
+            return null;
+        }
+        if (Values.masked(s)) {
+            return Map.of("$masked", true);
+        }
+        return switch (s) {
+            case Boolean b -> b;
+            case BigDecimal d -> decimal(d);
+            case Double d -> number(d);
+            case Number n -> n.longValue();
+            case String t -> t;
+            case Link l -> {
+                Map<String, Object> link = new LinkedHashMap<>();
+                link.put("id", l.id());
+                if (l.kind() != null) {
+                    link.put("kind", l.kind());
+                }
+                if (l.label() != null) {
+                    link.put("label", l.label());
+                }
+                yield Map.of("$link", link);
+            }
+            case DataNode d -> value(Values.simplify(d.unwrap()));
+            case Map<?, ?> m -> {
+                Map<String, Object> out = new LinkedHashMap<>();
+                m.forEach((k, x) -> out.put(String.valueOf(k), value(Values.simplify(x))));
+                yield out;
+            }
+            case Collection<?> l -> {
+                List<Object> out = new ArrayList<>();
+                l.forEach(x -> out.add(value(Values.simplify(x))));
+                yield out;
+            }
+            default -> s.toString();
+        };
+    }
+
+    static Object number(double d) {
+        if (Double.isNaN(d)) {
+            return Map.of("$num", "NaN");
+        }
+        if (Double.isInfinite(d)) {
+            return Map.of("$num", d > 0 ? "Infinity" : "-Infinity");
+        }
+        return d;
+    }
+
+    /** N4: a decimal a double holds is that number; otherwise {@code $dec} with plain digits, trailing fraction zeros removed. */
+    static Object decimal(BigDecimal b) {
+        BigDecimal s = b.stripTrailingZeros();
+        String plain = s.scale() < 0 ? s.setScale(0).toPlainString() : s.toPlainString();
+        double d = b.doubleValue();
+        if (!Double.isInfinite(d) && new BigDecimal(Double.toString(d)).compareTo(b) == 0) {
+            return number(d);
+        }
+        return Map.of("$dec", plain);
+    }
+}
