+package com.ash.drishti.rachana.conformance;
+
+import com.ash.drishti.rachana.format.Formats;
+import com.ash.drishti.testroots.TestRoots;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Stream;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Assumptions;
+import org.junit.jupiter.api.DynamicContainer;
+import org.junit.jupiter.api.DynamicNode;
+import org.junit.jupiter.api.DynamicTest;
+import org.junit.jupiter.api.TestFactory;
+
+/**
+ * Rachana's conformance cases on Drishti's compiler, the reference (plan R0 H1): one test per case, grouped by suite, from the pinned
+ * cases jar (or a checkout, {@link CaseSource#PROPERTY}). A verified case that fails or errs fails the build; an unverified one is
+ * reported as skipped with its difference (RUNNER exit code 3: green while cases are being harvested); a case of a kind this module
+ * does not answer ({@code sutra} is the engine's, {@code check} waits for Core's checker) is skipped as unsupported. The results file
+ * and summary are written to {@code target/conformance/}. With {@code -Drachana.conformance.record=true} and a checkout, unverified
+ * cases get the reference's {@code expect} (RUNNER 6).
+ */
+class RachanaConformanceTest {
+
+    @TestFactory
+    Stream<DynamicNode> rachanaCasesOnTheReference() throws IOException {
+        long t0 = System.currentTimeMillis();
+        CaseSource source = CaseSource.resolve();
+        Path out = Path.of(TestRoots.module(), "target", "conformance");
+        List<ConformanceRun.Result> results = ConformanceRun.run(source, new CoreKinds(formats(source, out)).kinds(), ConformanceRun.Options.of("jvm"));
+        ConformanceRun.write(results, out, ConformanceRun.Options.of("jvm"), source.origin(), System.currentTimeMillis() - t0);
+        if (Boolean.getBoolean("rachana.conformance.record")) {
+            Assertions.assertTrue(source.writable(), "record mode needs a checkout: -D" + CaseSource.PROPERTY + "=<drishti-rachana>");
+            System.out.println("recorded " + ConformanceRun.record(results) + " expect line(s) into " + source.origin());
+        }
+        return byFile(results).entrySet().stream().map(e -> DynamicContainer.dynamicContainer(e.getKey(), e.getValue().stream().map(RachanaConformanceTest::test)));
+    }
+
+    /**
+     * Core's format table ({@code spec/1/formats.yaml} of the same cases) and the Drishti profile's names (the core pack's
+     * {@code formats.yaml}), as the Rachana side's bootstrap bridge loads them.
+     */
+    static Formats formats(CaseSource source, Path scratch) throws IOException {
+        Files.createDirectories(scratch);
+        Path spec = scratch.resolve("spec-formats.yaml");
+        Files.writeString(spec, source.spec("formats.yaml"), StandardCharsets.UTF_8);
+        Path drishti = Path.of(TestRoots.repo(), "config", "packs", "core", "core", "config", "formats.yaml");
+        return Formats.load(null, List.of(spec.toString(), drishti.toString()));
+    }
+
+    static Map<String, List<ConformanceRun.Result>> byFile(List<ConformanceRun.Result> results) {
+        Map<String, List<ConformanceRun.Result>> m = new LinkedHashMap<>();
+        results.forEach(r -> m.computeIfAbsent(r.suite(), k -> new ArrayList<>()).add(r));
+        return m;
+    }
+
+    static DynamicTest test(ConformanceRun.Result r) {
+        return DynamicTest.dynamicTest(r.id().substring(r.id().indexOf('#') + 1), () -> {
+            switch (r.status()) {
+                case "pass" -> { }
+                case "unsupported" -> Assumptions.abort("unsupported: " + r.detail());
+                default -> {
+                    if (r.verified()) {
+                        Assertions.fail(r.id() + " " + r.status() + ": " + r.detail());
+                    }
+                    Assumptions.abort("unverified, " + r.status() + ": " + r.detail());
+                }
+            }
+        });
+    }
+}
