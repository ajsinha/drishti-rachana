<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.ash.rachana</groupId><artifactId>rachana-parent</artifactId><version>1.1.0</version></parent>
  <artifactId>rachana-core</artifactId>
  <name>rachana-core</name>

  <dependencies>
    <dependency><groupId>com.ash.rachana</groupId><artifactId>rachana-api</artifactId><version>${project.version}</version></dependency>
    <!-- SPLIT EXEMPTIONS (java/SPLIT_EXEMPTIONS.md): carried from the moved code until the step named there removes them. -->
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <!-- The bundled format table and world regions have their home in Drishti Elements: read from the pinned copy, no second copy. -->
      <resource>
        <directory>${rachana.repo.root}/js/vendor/drishti-elements/${drishti.elements.version}/data</directory>
        <includes><include>world-regions.yaml</include><include>formats.yaml</include></includes>
      </resource>
      <!-- The function catalogue is the contract: Core reads its parameter names and roles from it (one source, CoreParams). -->
      <resource>
        <directory>${rachana.repo.root}/spec/1</directory>
        <includes><include>functions.yaml</include></includes>
        <targetPath>rachana/el</targetPath>
      </resource>
    </resources>
  </build>
</project>
