<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.ash.rachana</groupId><artifactId>rachana-parent</artifactId><version>1.0.1</version></parent>
  <artifactId>rachana-tools</artifactId>
  <name>rachana-tools</name>
  <properties>
    <rachana.java.root>${project.basedir}/..</rachana.java.root>
  </properties>

  <dependencies>
    <dependency><groupId>com.ash.rachana</groupId><artifactId>rachana-core</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <!-- The problem-code table is the contract's: the language files are generated from it, no second copy. -->
      <resource>
        <directory>${rachana.repo.root}/spec/1</directory>
        <includes><include>language-tables.yaml</include></includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables><rachana.repo.root>${rachana.repo.root}</rachana.repo.root></systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
