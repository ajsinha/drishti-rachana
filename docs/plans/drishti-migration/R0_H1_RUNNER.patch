+++ b/compute/drishti-rachana/src/test/java/com/ash/drishti/rachana/conformance/Expect.java
@@ -0,0 +1,178 @@
+/*
+ * Project Drishti · Any data. Any domain. One grammar.
+ *
+ * Copyright (c) 2026 Ashutosh Sinha <ajsinha@gmail.com>.
+ * All rights reserved.
+ *
+ * PROPRIETARY AND CONFIDENTIAL.
+ *
+ * This file is the confidential and proprietary property of Ashutosh Sinha.
+ * Unauthorised copying, use, modification, distribution or disclosure of this
+ * file, via any medium, is strictly prohibited except with the express prior
+ * written permission of the copyright holder.
+ *
+ * See the LICENSE file in the root of this repository for the full terms.
+ */
+package com.ash.drishti.rachana.conformance;
+
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Compares a case's {@code expect} with the actual document (FORMAT sections 6 and 7): only the fields {@code expect} names, each
+ * by its canonical text, problems in order and in full with only the fields an expected problem names, {@code tolerance} for a
+ * number, {@code at} by JSON Pointer. The rules of the Rachana driver ({@code tools/conformance/rachana_conformance.py}), so both
+ * runners give the same status for the same actual document.
+ */
+public final class Expect {
+
+    private Expect() {}
+
+    /** Whether {@code actual} meets {@code expect}; the first reason it does not is added to {@code why}. */
+    public static boolean matches(Map<String, Object> expect, Map<String, Object> actual, Map<String, Object> tolerance, List<String> why) {
+        for (Map.Entry<String, Object> e : expect.entrySet()) {
+            String field = e.getKey();
+            Object exp = e.getValue();
+            if ("tolerance".equals(field)) {
+                continue;
+            }
+            Object act = actual.get(field);
+            switch (field) {
+                case "problems" -> {
+                    List<?> el = exp instanceof List<?> l ? l : List.of();
+                    List<?> al = act instanceof List<?> l ? l : List.of();
+                    if (el.size() != al.size()) {
+                        why.add("problems: expected " + el.size() + ", actual " + al.size() + " " + Canonical.of(al));
+                        return false;
+                    }
+                    for (int i = 0; i < el.size(); i++) {
+                        if (!problem(CoreKinds.map(el.get(i)), CoreKinds.map(al.get(i)), why)) {
+                            return false;
+                        }
+                    }
+                }
+                case "error" -> {
+                    if (!(act instanceof Map<?, ?>)) {
+                        why.add("error: expected " + Canonical.of(exp) + ", actual " + Canonical.of(act));
+                        return false;
+                    }
+                    Map<String, Object> a = new java.util.LinkedHashMap<>(CoreKinds.map(act));
+                    a.put("severity", "error");
+                    if (!problem(CoreKinds.map(exp), a, why)) {
+                        why.add("error: expected " + Canonical.of(exp) + ", actual " + Canonical.of(act));
+                        return false;
+                    }
+                }
+                case "at" -> {
+                    for (Map.Entry<String, Object> p : CoreKinds.map(exp).entrySet()) {
+                        Object[] found = pointer(actual, p.getKey());
+                        if (found == null) {
+                            why.add("at " + p.getKey() + ": nothing there");
+                            return false;
+                        }
+                        if (!Canonical.of(p.getValue()).equals(Canonical.of(found[0]))) {
+                            why.add("at " + p.getKey() + ": expected " + Canonical.of(p.getValue()) + ", actual " + Canonical.of(found[0]));
+                            return false;
+                        }
+                    }
+                }
+                default -> {
+                    if ("value".equals(field) && tolerance != null && exp instanceof Number en && act instanceof Number an) {
+                        double d = Math.abs(en.doubleValue() - an.doubleValue());
+                        double abs = tolerance.get("abs") instanceof Number n ? n.doubleValue() : 0;
+                        double rel = tolerance.get("rel") instanceof Number n ? n.doubleValue() : 0;
+                        if (d > abs && d > rel * Math.abs(en.doubleValue())) {
+                            why.add("value: expected " + Canonical.of(exp) + " within " + Canonical.of(tolerance) + ", actual " + Canonical.of(act));
+                            return false;
+                        }
+                    } else if (!Canonical.of(exp).equals(Canonical.of(act))) {
+                        why.add(field + ": expected " + Canonical.of(exp) + ", actual " + Canonical.of(act));
+                        return false;
+                    }
+                }
+            }
+        }
+        return true;
+    }
+
+    /** FORMAT 6: the fields the expected problem names; {@code severity} {@code error} when it names none; {@code doc} never. */
+    static boolean problem(Map<String, Object> exp, Map<String, Object> act, List<String> why) {
+        for (Map.Entry<String, Object> e : exp.entrySet()) {
+            String k = e.getKey();
+            Object v = e.getValue();
+            switch (k) {
+                case "doc" -> { }
+                case "messageStart" -> {
+                    String m = act.get("message") instanceof String s ? s : "";
+                    if (!m.startsWith(String.valueOf(v))) {
+                        why.add("message: expected to start " + Canonical.of(v) + ", actual " + Canonical.of(act.get("message")));
+                        return false;
+                    }
+                }
+                case "range", "expr" -> {
+                    Map<String, Object> a = CoreKinds.map(act.get(k));
+                    for (Map.Entry<String, Object> part : CoreKinds.map(v).entrySet()) {
+                        if (part.getValue() instanceof Map<?, ?> inner) {
+                            Map<String, Object> ai = CoreKinds.map(a.get(part.getKey()));
+                            for (Map.Entry<?, ?> x : inner.entrySet()) {
+                                if (!Canonical.of(x.getValue()).equals(Canonical.of(ai.get(String.valueOf(x.getKey()))))) {
+                                    why.add(k + "." + part.getKey() + "." + x.getKey() + ": expected " + Canonical.of(x.getValue()) + ", actual "
+                                            + Canonical.of(ai.get(String.valueOf(x.getKey()))));
+                                    return false;
+                                }
+                            }
+                        } else if (!Canonical.of(part.getValue()).equals(Canonical.of(a.get(part.getKey())))) {
+                            why.add(k + "." + part.getKey() + ": expected " + Canonical.of(part.getValue()) + ", actual " + Canonical.of(a.get(part.getKey())));
+                            return false;
+                        }
+                    }
+                }
+                default -> {
+                    if ("severity".equals(k) || act.containsKey(k) || v != null) {
+                        Object av = act.containsKey(k) ? act.get(k) : "severity".equals(k) ? "error" : null;
+                        if (!Canonical.of(av).equals(Canonical.of(v))) {
+                            why.add(k + ": expected " + Canonical.of(v) + ", actual " + Canonical.of(av));
+                            return false;
+                        }
+                    }
+                }
+            }
+        }
+        if (!exp.containsKey("severity") && !"error".equals(act.getOrDefault("severity", "error"))) {
+            why.add("severity: expected error");
+            return false;
+        }
+        return true;
+    }
+
+    /** RFC 6901: the value at {@code pointer} in {@code doc} as a one-element array (it may be null), or null when nothing is there. */
+    static Object[] pointer(Object doc, String pointer) {
+        if (pointer.isEmpty()) {
+            return new Object[] {doc};
+        }
+        Object at = doc;
+        for (String raw : pointer.substring(1).split("/", -1)) {
+            String token = raw.replace("~1", "/").replace("~0", "~");
+            if (at instanceof Map<?, ?> m) {
+                if (!m.containsKey(token)) {
+                    return null;
+                }
+                at = m.get(token);
+            } else if (at instanceof List<?> l) {
+                int i;
+                try {
+                    i = Integer.parseInt(token);
+                } catch (NumberFormatException e) {
+                    return null;
+                }
+                if (i < 0 || i >= l.size()) {
+                    return null;
+                }
+                at = l.get(i);
+            } else {
+                return null;
+            }
+        }
+        return new Object[] {at};
+    }
+}
