{
  "$comment": "Copyright (c) 2026 Ashutosh Sinha. Specification licence: ../../LICENSE-SPEC.md (draft, not yet in force). The shape of functions.yaml, written by hand; draft, completed with the coverage gate in R0 step H5.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drishti.local/schema/functions.json",
  "title": "Rachana function catalogue (functions.yaml)",
  "description": "The file is YAML; validate its parsed form. Core entries are fully specified; profile and engine entries are carried as drafted from the reference and are classified in R0 step H5.",
  "type": "object",
  "required": ["functions_version", "language", "status", "core", "deprecated", "drishti_profile", "engine_list_functions"],
  "additionalProperties": false,
  "properties": {
    "functions_version": {"const": 1},
    "language": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "complete"]},
    "roles_since": {"type": "string", "pattern": "^1\\.[0-9]+$", "description": "the language level that brought parameter roles (role on a parameter); a level before it is written without them (tools/regime/levels.py)"},
    "core": {"type": "array", "items": {"$ref": "#/$defs/coreFunction"}},
    "deprecated": {"type": "array", "items": {"$ref": "#/$defs/deprecated"}},
    "drishti_profile": {"type": "array", "items": {"$ref": "#/$defs/profileFunction"}},
    "engine_list_functions": {"type": "array", "items": {"$ref": "#/$defs/engineFunction"}}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
    "code": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{4}$"},
    "paramType": {"enum": ["number", "integer", "text", "boolean", "date", "timestamp", "list", "any", "expression", "link"]},
    "param": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "type": {"$ref": "#/$defs/paramType"},
        "optional": {"const": true},
        "variadic": {"const": true},
        "role": {"enum": ["column"], "description": "column: the argument names a column (or a dotted path from one) of the rows of the function's list; a typed fragment's text argument here is renamed to the caller's column at compile time (SPEC 2.5, decision L-21)"},
        "default": {"description": "the value used when the argument is left out; the string \"empty\" means no value (empty)"},
        "enum": {"type": "array", "items": {"type": "string"}, "minItems": 1, "description": "the closed set a literal argument is checked against at compile time"}
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "when"],
      "additionalProperties": false,
      "properties": {"code": {"$ref": "#/$defs/code"}, "when": {"type": "string", "minLength": 1}}
    },
    "example": {
      "type": "object",
      "required": ["expr"],
      "additionalProperties": false,
      "properties": {
        "expr": {"type": "string", "minLength": 1},
        "result": {"description": "the typed answer: number, text, boolean, null (empty) or a list; the string \"see says\" when it depends on data not in the case"},
        "error": {"$ref": "#/$defs/code"},
        "says": {"type": "string"},
        "needs_fixture": {"const": true}
      },
      "oneOf": [{"required": ["result"]}, {"required": ["error"]}]
    },
    "coreFunction": {
      "type": "object",
      "required": ["name", "family", "signature", "eval", "params", "returns", "nulls", "errors", "description", "examples", "since"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "family": {"enum": ["logic", "math", "text", "dates", "lists", "aggregates", "statistics", "finance"]},
        "signature": {"type": "string"},
        "eval": {"enum": ["eager", "form", "syntax"]},
        "params": {"type": "array", "items": {"$ref": "#/$defs/param"}},
        "returns": {"type": "string"},
        "nulls": {
          "type": "object",
          "required": ["empty", "masked"],
          "additionalProperties": false,
          "properties": {"empty": {"type": "string"}, "masked": {"type": "string"}}
        },
        "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}},
        "tolerance": {"type": "number", "exclusiveMinimum": 0},
        "description": {"type": "string", "minLength": 1},
        "deprecated_spellings": {
          "type": "array",
          "items": {"type": "object", "required": ["name", "note"], "additionalProperties": false, "properties": {"name": {"$ref": "#/$defs/name"}, "note": {"type": "string"}}}
        },
        "examples": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/example"}},
        "since": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
      }
    },
    "deprecated": {
      "type": "object",
      "required": ["spelling", "replace_with", "warning", "note"],
      "additionalProperties": false,
      "properties": {"spelling": {"$ref": "#/$defs/name"}, "replace_with": {"$ref": "#/$defs/name"}, "warning": {"const": "RCH-2090"}, "note": {"type": "string"}}
    },
    "profileFunction": {
      "type": "object",
      "required": ["name", "family", "runs", "signature", "returns", "description", "classify"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "family": {"type": "string"},
        "runs": {"enum": ["R", "E"], "description": "R: the host evaluates it as a scalar; E: the host's engine computes it"},
        "signature": {"type": "string"},
        "params": {"type": "array", "items": {"type": "object", "required": ["name", "type"], "properties": {"name": {"type": "string"}, "type": {"type": "string"}, "default": {}, "keyword_only": {"type": "boolean"}, "variadic": {"type": "boolean"}}}},
        "returns": {"type": "string"},
        "scopes": {"type": "array", "items": {"type": "string"}},
        "description": {"type": "string"},
        "edge_cases": {"type": "object", "additionalProperties": {"type": "string"}},
        "examples": {"type": "array", "items": {"type": "object", "required": ["expr"], "properties": {"expr": {"type": "string"}, "says": {"type": "string"}}}},
        "classify": {"const": "profile"}
      }
    },
    "engineFunction": {
      "type": "object",
      "required": ["name", "signature", "form", "description", "classify"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "signature": {"type": "string"},
        "form": {"enum": ["mergeable", "holistic", "list"]},
        "description": {"type": "string"},
        "classify": {"const": "pending (H5)"}
      }
    }
  }
}
