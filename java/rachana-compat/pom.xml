<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.ash.rachana</groupId><artifactId>rachana-parent</artifactId><version>1.0.1</version></parent>
  <artifactId>rachana-compat</artifactId>
  <name>rachana-compat</name>
  <description>The compatibility regime's gates CG1 to CG6 (SUTRA_EXPANSION 6.5): tests and their tooling only, no product code.</description>
  <properties>
    <rachana.java.root>${project.basedir}/..</rachana.java.root>
  </properties>

  <dependencies>
    <dependency><groupId>com.ash.rachana</groupId><artifactId>rachana-api</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.ash.rachana</groupId><artifactId>rachana-core</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.ash.rachana</groupId><artifactId>rachana-conformance</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.ash.rachana</groupId><artifactId>rachana-tools</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <rachana.repo.root>${rachana.repo.root}</rachana.repo.root>
            <rachana.reference.classpath>${rachana.reference.classpath}</rachana.reference.classpath>
            <rachana.compat.runtime>${rachana.compat.runtime}</rachana.compat.runtime>
            <rachana.compat.binds.out>${rachana.compat.binds.out}</rachana.compat.binds.out>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
