<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.ash.rachana</groupId><artifactId>rachana-parent</artifactId><version>0.11.0-SNAPSHOT</version></parent>
  <artifactId>rachana-guards</artifactId>
  <name>rachana-guards</name>
  <description>Test-only module: source-scan guards over the whole reactor. Not released.</description>
  <dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <properties>
    <node>node</node>
    <rachana.node.skip>false</rachana.node.skip>
  </properties>
  <build>
    <plugins>
      <plugin><artifactId>maven-jar-plugin</artifactId><configuration><skipIfEmpty>true</skipIfEmpty></configuration></plugin>
      <plugin><artifactId>maven-install-plugin</artifactId><configuration><skip>true</skip></configuration></plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <rachana.java.root>${rachana.java.root}</rachana.java.root>
            <rachana.repo.root>${rachana.repo.root}</rachana.repo.root>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- the Node tests of the runtime, the command line and the Studio run with every build (so they cannot rot unseen). The Java-dependent
           ones find the classes of the earlier modules (this module is last); the bundle-dependent ones need js/packages/rachana/dist
           (rachana-js builds the bundles and copies them there before this module runs; the run FAILS, never skips quietly, when they are missing or a test was skipped). Node 20+ on the PATH, or -Dnode=/path/to/node; -Drachana.node.skip=true leaves them out. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.6.3</version>
        <executions>
          <execution><id>node-tests</id><phase>test</phase><goals><goal>exec</goal></goals><configuration>
            <skip>${rachana.node.skip}</skip>
            <executable>${node}</executable>
            <workingDirectory>${rachana.repo.root}</workingDirectory>
            <arguments><argument>tools/js/node_tests.mjs</argument><argument>js/packages/*/test</argument></arguments>
          </configuration></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
