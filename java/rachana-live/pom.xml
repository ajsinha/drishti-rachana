<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.ash.rachana</groupId><artifactId>rachana-parent</artifactId><version>0.12.0</version></parent>
  <artifactId>rachana-live</artifactId>
  <name>rachana-live</name>
  <!-- Live tables (docs/design/LIVE_TABLES.md): the JVM engine behind the Data Protocol's live tables. Depends on rachana-data only:
       no Kafka, no lake, no database driver, no web framework. Never in Core and never compiled to JavaScript (LiveModuleGuardTest). -->
  <dependencies>
    <dependency><groupId>com.ash.rachana</groupId><artifactId>rachana-data</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <properties>
    <rachana.arrow.opens>--add-opens=java.base/java.nio=org.apache.arrow.memory.core,ALL-UNNAMED</rachana.arrow.opens>
  </properties>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <!-- The adapter test speaks HTTP with the JDK client (TableClient takes one). -->
        <configuration>
          <argLine>${rachana.arrow.opens} --add-reads com.ash.rachana.live=java.net.http</argLine>
          <systemPropertyVariables><rachana.repo.root>${rachana.repo.root}</rachana.repo.root></systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- The live test adapter's module path (LiveReferenceServer), for tools/conformance/protocol_check.py live. -->
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>runtime-classpath</id>
            <phase>package</phase>
            <goals><goal>build-classpath</goal></goals>
            <configuration>
              <outputFile>${project.build.directory}/runtime-classpath.txt</outputFile>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- rachana-data's Arrow dependencies reach this module transitively; it adds none of its own. -->
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-rules</id>
            <configuration>
              <rules>
                <bannedDependencies>
                  <includes combine.children="append">
                    <include>com.fasterxml.jackson.core:*</include>
                    <include>com.fasterxml.jackson.datatype:jackson-datatype-jsr310</include>
                    <include>org.slf4j:slf4j-api</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
