{
  "$comment": "Copyright (c) 2026 Ashutosh Sinha. Specification licence: ../../../LICENSE-SPEC.md (draft, not yet in force). Normative with PROTOCOL.md; where they disagree, that is a defect in one of them.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ajsinha.github.io/drishti-rachana/spec/1/data-protocol/schema.json",
  "title": "Rachana Data Protocol v1: table schema",
  "description": "The schema document of one table (GET {base}/tables/{name}). PROTOCOL.md section 2. $defs also holds the base document and the table catalogue (section 4). Unknown fields are ignored by readers (section 14).",
  "type": "object",
  "required": ["name", "columns"],
  "properties": {
    "name": { "$ref": "#/$defs/tableName" },
    "title": { "type": "string" },
    "key": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" }, "description": "Column names, in key order." },
    "columns": { "type": "array", "minItems": 1, "maxItems": 2000, "items": { "$ref": "#/$defs/column" } },
    "rows": { "type": "integer", "minimum": 0, "description": "Row count when cheap." },
    "can": { "$ref": "#/$defs/can" },
    "version": { "$ref": "#/$defs/version" },
    "limits": { "$ref": "#/$defs/limits" },
    "append": { "$ref": "#/$defs/append" },
    "rowVersion": { "type": "string", "description": "A live table (section 16): the column holding each row's record version." },
    "changedBy": { "type": "string", "description": "A live table: the column naming who made a row's last change." },
    "changedAt": { "type": "string", "description": "A live table: the column holding when a row last changed." },
    "live": { "$ref": "#/$defs/live" },
    "capped": { "type": "boolean", "description": "A live table read whole stopped at its row cap: not every row is held." },
    "narrow": { "type": "object", "required": ["anyOf"], "properties": { "anyOf": { "type": "array", "minItems": 1, "items": { "type": "string" } } },
      "description": "A list must filter on one of these columns (can: narrow); a bare list is rdp.query.narrow." },
    "view": { "$ref": "#/$defs/view" },
    "write": { "$ref": "#/$defs/write" }
  },
  "$defs": {
    "tableName": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$", "maxLength": 128 },
    "columnType": { "enum": ["string", "integer", "decimal", "number", "boolean", "date", "timestamp", "time", "list", "object"] },
    "column": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "type": { "$ref": "#/$defs/columnType" },
        "nullable": { "type": "boolean", "default": true },
        "label": { "type": "string" },
        "fmt": { "type": "string", "description": "A Rachana format name." },
        "unit": { "type": "string" },
        "scale": { "type": "integer", "minimum": 0, "maximum": 38, "description": "Digits after the point; decimal only." },
        "grain": { "enum": ["day", "month", "quarter", "year"], "description": "date only." },
        "items": { "$ref": "#/$defs/columnType", "description": "Element type; list only." },
        "hint": { "type": "string" },
        "masked": { "type": "boolean", "description": "The whole column is masked for this reader." },
        "heavy": { "type": "boolean", "description": "A live table (section 16): never in a list page or a patch; read by fetching one row by key." }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "list" } }, "required": ["type"] }, "then": { "required": ["items"] } }
      ]
    },
    "can": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["page", "offset", "sort", "filter", "group", "count", "snapshot", "arrow", "arrow.lz4", "changes", "changes.filter", "replay",
                         "changes.window", "write", "narrow"] }
    },
    "version": {
      "type": "object", "required": ["epoch", "seq"],
      "properties": { "epoch": { "type": "string", "minLength": 1, "maxLength": 64 }, "seq": { "type": "integer", "minimum": 0 } }
    },
    "limits": {
      "type": "object",
      "properties": {
        "pageRows": { "type": "integer", "minimum": 1 },
        "arrowBatchRows": { "type": "integer", "minimum": 1 },
        "wholeTableRows": { "type": "integer", "minimum": 1 },
        "wholeTableBytes": { "type": "integer", "minimum": 1 },
        "queryBytes": { "type": "integer", "minimum": 1 },
        "filterDepth": { "type": "integer", "minimum": 1 },
        "inList": { "type": "integer", "minimum": 1 },
        "columns": { "type": "integer", "minimum": 1 },
        "cellBytes": { "type": "integer", "minimum": 1 },
        "queryMs": { "type": "integer", "minimum": 1 },
        "patchRows": { "type": "integer", "minimum": 1 },
        "patchBytes": { "type": "integer", "minimum": 1 },
        "subscriptions": { "type": "integer", "minimum": 1 },
        "messageBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "live": {
      "description": "A live table's stream (section 16): up, or paused (its broker is absent: the snapshot is served).",
      "type": "object", "required": ["state"], "properties": { "state": { "enum": ["up", "paused"] }, "reason": { "type": "string" } }
    },
    "view": {
      "description": "A live table's own presentation (section 16): its order, grouping, subtotals and column widths.",
      "type": "object",
      "properties": {
        "sort": { "type": "array", "items": { "type": "object", "required": ["col"], "properties": { "col": { "type": "string" }, "dir": { "enum": ["asc", "desc"] } } } },
        "groupBy": { "type": "array", "items": { "type": "string" } },
        "subtotals": { "type": "array", "items": { "type": "string" } },
        "widths": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } }
      }
    },
    "write": {
      "description": "For a reader who may edit a live table (section 16, can: write): the columns they may set, each with its form field rules, and whether a reason is asked.",
      "type": "object", "required": ["columns"],
      "properties": {
        "columns": { "type": "object", "additionalProperties": { "type": "object" } },
        "reason": { "enum": ["none", "optional", "required"] }
      }
    },
    "append": { "type": "object", "required": ["window"], "properties": { "window": { "type": "integer", "minimum": 1 } } },
    "maskedValue": { "type": "object", "required": ["$masked"], "properties": { "$masked": { "const": true } }, "additionalProperties": false },
    "tableSummary": {
      "type": "object", "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/tableName" }, "title": { "type": "string" },
        "key": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "integer", "minimum": 0 }, "can": { "$ref": "#/$defs/can" }
      }
    },
    "catalogue": {
      "description": "GET {base}/tables.",
      "type": "object", "required": ["tables"],
      "properties": { "tables": { "type": "array", "items": { "$ref": "#/$defs/tableSummary" } } }
    },
    "base": {
      "description": "GET {base}.",
      "type": "object", "required": ["protocol", "v", "tables"],
      "properties": {
        "protocol": { "const": "rdp" }, "v": { "const": 1 },
        "tables": { "type": "string" }, "changes": { "type": "string" },
        "limits": { "$ref": "#/$defs/limits" }
      }
    }
  }
}
