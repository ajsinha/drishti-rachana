+
+/**
+ * The Rachana pin is one fact (Rachana plan section 5, guard "pin is one fact", R0 H1 jar part): the parent POM's
+ * {@code drishti.rachana.version}, the one version folder of each artefact under {@code packaging/pinned/maven/com/ash/rachana/}, and
+ * {@code packaging/pinned/drishti-rachana.json} agree; every jar's SHA-384 is the manifest's and its {@code .sha1} is right (nobody edits
+ * the copy); the cases jar names the commit the manifest records; the file repository is declared once, releases only, checksums
+ * enforced; when the manifest names the Elements Rachana was built with, they are the console's vendored ones (C9). The JavaScript part
+ * ({@code test_rachana_pinned.py}) comes with the bundles (B8).
+ */
+class RachanaPinGuardTest {
+
+    static final ObjectMapper JSON = new ObjectMapper();
+    static final Pattern PROPERTY = Pattern.compile("<drishti\\.rachana\\.version>([^<]+)</drishti\\.rachana\\.version>");
+    static final Pattern ELEMENTS = Pattern.compile("<drishti\\.elements\\.version>([^<]+)</drishti\\.elements\\.version>");
+
+    @Test
+    void theRachanaPinIsOneFact() throws Exception {
+        assertThat(problems(RepositoryFiles.root())).isEmpty();
+    }
+
+    @Test
+    void aWrongPinFailsTheGuard(@TempDir Path tmp) throws Exception {
+        Path root = RepositoryFiles.root();
+        assertThat(problems(copy(root, tmp.resolve("bytes"), c -> {
+            Path jar = only(c.resolve("packaging/pinned/maven/com/ash/rachana/rachana-conformance-cases"), ".jar");
+            Files.write(jar, new byte[] {1, 2, 3}, java.nio.file.StandardOpenOption.APPEND);
+        }))).anyMatch(p -> p.contains("SHA-384"));
+        assertThat(problems(copy(root, tmp.resolve("property"), c -> {
+            Path pom = c.resolve("pom.xml");
+            Files.writeString(pom, PROPERTY.matcher(Files.readString(pom)).replaceFirst("<drishti.rachana.version>9.9.9</drishti.rachana.version>"));
+        }))).anyMatch(p -> p.contains("9.9.9"));
+        assertThat(problems(copy(root, tmp.resolve("second"), c -> {
+            Path base = c.resolve("packaging/pinned/maven/com/ash/rachana/rachana-conformance-cases");
+            Files.createDirectories(base.resolve("0.0.1"));
+        }))).anyMatch(p -> p.contains("one version"));
+        assertThat(problems(copy(root, tmp.resolve("commit"), c -> {
+            Path m = c.resolve("packaging/pinned/drishti-rachana.json");
+            Files.writeString(m, Files.readString(m).replaceFirst("\"commit\" : \"[0-9a-f]+\"|\"commit\": \"[0-9a-f]+\"", "\"commit\": \"0000\""));
+        }))).anyMatch(p -> p.contains("commit"));
+    }
+
+    /** Everything that disagrees, as sentences; empty when the pin is one fact. */
+    static List<String> problems(Path root) throws IOException {
+        List<String> out = new ArrayList<>();
+        String pom = Files.readString(root.resolve("pom.xml"));
+        Matcher pm = PROPERTY.matcher(pom);
+        if (!pm.find()) {
+            return List.of("pom.xml has no drishti.rachana.version");
+        }
+        String version = pm.group(1).trim();
+        if (count(pom, "<id>rachana-pinned</id>") != 1 || !pom.contains("/packaging/pinned/maven</url>") || !pom.contains("<checksumPolicy>fail</checksumPolicy>")) {
+            out.add("pom.xml must declare the file repository rachana-pinned once (packaging/pinned/maven, checksumPolicy fail)");
+        }
+        Path pinned = root.resolve("packaging/pinned");
+        JsonNode manifest = JSON.readTree(pinned.resolve("drishti-rachana.json").toFile());
+        if (!version.equals(manifest.path("version").asText())) {
+            out.add("drishti.rachana.version " + version + " is not the manifest's version " + manifest.path("version").asText());
+        }
+        String commit = manifest.path("commit").asText();
+        Path group = pinned.resolve("maven/com/ash/rachana");
+        List<String> listed = new ArrayList<>();
+        manifest.path("jars").fieldNames().forEachRemaining(listed::add);
+        List<String> seen = new ArrayList<>();
+        try (Stream<Path> artefacts = Files.list(group)) {
+            for (Path a : artefacts.filter(Files::isDirectory).sorted().toList()) {
+                List<Path> versions;
+                try (Stream<Path> v = Files.list(a)) {
+                    versions = v.filter(Files::isDirectory).sorted().toList();
+                }
+                if (versions.size() != 1 || !versions.get(0).getFileName().toString().equals(version)) {
+                    out.add(a.getFileName() + " must hold one version, " + version + "; it holds " + versions.stream().map(p -> p.getFileName().toString()).toList());
+                }
+                for (Path v : versions) {
+                    try (Stream<Path> files = Files.list(v)) {
+                        for (Path f : files.sorted().toList()) {
+                            String name = f.getFileName().toString();
+                            if (name.endsWith(".jar") || name.endsWith(".pom")) {
+                                Path sha1 = f.resolveSibling(name + ".sha1");
+                                if (!Files.exists(sha1) || !Files.readString(sha1).trim().startsWith(digest(f, "SHA-1"))) {
+                                    out.add(name + ": its .sha1 is missing or wrong");
+                                }
+                            }
+                            if (name.endsWith(".jar")) {
+                                seen.add(name);
+                                String want = manifest.path("jars").path(name).asText();
+                                if (!digest(f, "SHA-384").equals(want)) {
+                                    out.add(name + ": SHA-384 differs from the manifest (a pinned file is never edited; move the pin)");
+                                }
+                                stamp(f, version, commit, out);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        for (String name : listed) {
+            if (!seen.contains(name)) {
+                out.add("the manifest lists " + name + ", which is not in packaging/pinned/maven");
+            }
+        }
+        for (String name : seen) {
+            if (!listed.contains(name)) {
+                out.add(name + " is not in the manifest");
+            }
+        }
+        JsonNode elements = manifest.path("elements");
+        if (!elements.path("version").isNull() && !elements.path("version").isMissingNode()) {
+            Matcher em = ELEMENTS.matcher(pom);
+            String ev = em.find() ? em.group(1).trim() : "";
+            if (!ev.equals(elements.path("version").asText())) {
+                out.add("Rachana was built with Elements " + elements.path("version").asText() + ", the console vendors " + ev);
+            }
+            Path data = root.resolve("drishti-console/web/static/vendor/drishti-elements/" + ev + "/data");
+            for (String table : List.of("formats.yaml", "world-regions.yaml")) {
+                if (!Files.exists(data.resolve(table)) || !digest(data.resolve(table), "SHA-384").equals(elements.path(table).asText())) {
+                    out.add("Rachana's " + table + " differs from the console's vendored Elements " + ev);
+                }
+            }
+        }
+        return out;
+    }
+
+    /** A cases jar says which version and commit it is ({@code META-INF/rachana-cases.json}); a code jar is checked by its hash alone. */
+    static void stamp(Path jar, String version, String commit, List<String> out) throws IOException {
+        try (ZipFile z = new ZipFile(jar.toFile())) {
+            ZipEntry e = z.getEntry("META-INF/rachana-cases.json");
+            if (e == null) {
+                return;
+            }
+            try (InputStream in = z.getInputStream(e)) {
+                JsonNode s = JSON.readTree(in);
+                if (!version.equals(s.path("version").asText())) {
+                    out.add(jar.getFileName() + " says version " + s.path("version").asText());
+                }
+                if (!commit.equals(s.path("commit").asText())) {
+                    out.add(jar.getFileName() + " was built from commit " + s.path("commit").asText() + ", the manifest says " + commit);
+                }
+            }
+        } catch (java.util.zip.ZipException e) {
+            out.add(jar.getFileName() + " is not a jar: " + e.getMessage());
+        }
+    }
+
+    static String digest(Path f, String algorithm) throws IOException {
+        try {
+            return HexFormat.of().formatHex(MessageDigest.getInstance(algorithm).digest(Files.readAllBytes(f)));
+        } catch (java.security.NoSuchAlgorithmException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    static int count(String s, String part) {
+        int n = 0;
+        for (int i = s.indexOf(part); i >= 0; i = s.indexOf(part, i + 1)) {
+            n++;
+        }
+        return n;
+    }
+
+    interface Change {
+        void apply(Path copy) throws IOException;
+    }
+
+    /** The pom and packaging/pinned copied into {@code to}, then changed. */
+    static Path copy(Path root, Path to, Change change) throws IOException {
+        Files.createDirectories(to);
+        Files.writeString(to.resolve("pom.xml"), Files.readString(root.resolve("pom.xml"), StandardCharsets.UTF_8), StandardCharsets.UTF_8);
+        Path from = root.resolve("packaging/pinned");
+        try (Stream<Path> s = Files.walk(from)) {
+            for (Path p : s.toList()) {
+                Path q = to.resolve("packaging/pinned").resolve(from.relativize(p).toString());
+                if (Files.isDirectory(p)) {
+                    Files.createDirectories(q);
+                } else {
+                    Files.copy(p, q);
+                }
+            }
+        }
+        change.apply(to);
+        return to;
+    }
+
+    static Path only(Path artefact, String suffix) throws IOException {
+        try (Stream<Path> s = Files.walk(artefact)) {
+            return s.filter(p -> p.toString().endsWith(suffix)).findFirst().orElseThrow();
+        }
+    }
+}
